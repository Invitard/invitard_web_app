---
/**
 * Contenido visual de un short: el video (si existe) o una vista animada de la
 * invitación construida con la foto y los textos del modelo.
 * Las animaciones sólo corren cuando un ancestro tiene la clase `is-live`.
 */
import { Picture } from 'astro:assets';
import type { Short } from '../data/shorts';
import { getLang } from '../i18n';
import { url } from '../data/site';

interface Props {
	short: Short;
	widths: number[];
	sizes: string;
}

const { short: reel, widths, sizes } = Astro.props;
const videoSrc = reel.video ? url(`/shorts/${reel.video}`) : undefined;
const t =
	getLang(Astro.url) === 'en'
		? { days: 'days', rsvp: 'RSVP now' }
		: { days: 'días', rsvp: 'Confirmar asistencia' };
---

<div class="reel-media" data-has-video={videoSrc ? '' : undefined}>
	<Picture
		src={reel.poster}
		alt={reel.posterAlt}
		{widths}
		{sizes}
		formats={['avif', 'webp']}
		loading="lazy"
		decoding="async"
		class="reel-poster"
	/>
	{
		videoSrc && (
			<video class="reel-video" data-src={videoSrc} muted loop playsinline preload="none" disablepictureinpicture aria-hidden="true" />
		)
	}
	{
		!videoSrc && (
			<div class="reel-invite" aria-hidden="true">
				<span class="ri-script">{reel.script}</span>
				<span class="ri-names">{reel.names}</span>
				<span class="ri-date">{reel.date}</span>
				<span class="ri-count">
					<b>24</b>{t.days} <b>08</b>h <b>31</b>min
				</span>
				<span class="ri-btn">{t.rsvp}</span>
			</div>
		)
	}
	<span class="reel-progress" aria-hidden="true"><i></i></span>
</div>

<style>
	.reel-media {
		--reel-loop: 9s;
		position: absolute;
		inset: 0;
		overflow: clip;
		background: oklch(0.2 0.02 270);
		container-type: inline-size;

		& :global(img) {
			position: absolute;
			inset: 0;
			inline-size: 100%;
			block-size: 100%;
			object-fit: cover;
			transform-origin: 60% 40%;
		}
	}

	.reel-video {
		position: absolute;
		inset: 0;
		inline-size: 100%;
		block-size: 100%;
		object-fit: cover;
		opacity: 0;
		transition: opacity 0.4s;

		&.is-playing {
			opacity: 1;
		}
	}

	/* ── Invitación animada (cuando aún no hay video) ── */
	.reel-invite {
		position: absolute;
		inset: 0;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: end;
		gap: 0.35em;
		padding: 1em 0.9em 22%;
		color: white;
		text-align: center;
		font-size: clamp(0.62rem, 7.2cqi, 1.15rem);
		background: linear-gradient(transparent 30%, oklch(0.15 0.02 270 / 0.85));

		& > * {
			text-shadow: 0 1px 12px oklch(0 0 0 / 0.35);
		}
	}

	.ri-script {
		font-family: var(--font-script);
		font-size: 1.7em;
		line-height: 1;
	}

	.ri-names {
		font-size: 2.1em;
		font-weight: 800;
		line-height: 1;
		letter-spacing: -0.02em;
		text-wrap: balance;
	}

	.ri-date {
		font-size: 0.78em;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		opacity: 0.88;
	}

	.ri-count {
		display: flex;
		align-items: center;
		gap: 0.3em;
		margin-block: 0.4em;
		font-size: 0.7em;
		text-transform: uppercase;

		& b {
			display: inline-block;
			min-inline-size: 2.2em;
			padding: 0.2em 0.3em;
			border-radius: 0.5em;
			background: oklch(1 0 0 / 0.18);
			font-size: 1.35em;
			font-variant-numeric: tabular-nums;
		}
	}

	.ri-btn {
		padding: 0.55em 1.2em;
		border-radius: 999px;
		background: var(--sky);
		color: var(--ink);
		font-size: 0.85em;
		font-weight: 700;
	}

	/* Barra de progreso tipo historia */
	.reel-progress {
		position: absolute;
		inset: 0.6rem 0.75rem auto;
		block-size: 3px;
		border-radius: 3px;
		background: oklch(1 0 0 / 0.3);
		overflow: clip;
		z-index: 2;

		& i {
			display: block;
			block-size: 100%;
			background: white;
			transform-origin: left;
			scale: var(--progress, 0) 1;
		}
	}

	@media (prefers-reduced-motion: no-preference) {
		.reel-media:not([data-has-video]) {
			& :global(img) {
				animation: kenburns var(--reel-loop) ease-in-out infinite alternate paused;
			}

			& .reel-invite > * {
				animation: invite-in var(--reel-loop) cubic-bezier(0.2, 0.8, 0.2, 1) infinite paused;
			}

			& .ri-script {
				animation-delay: 0.2s;
			}
			& .ri-names {
				animation-delay: 0.5s;
			}
			& .ri-date {
				animation-delay: 0.8s;
			}
			& .ri-count {
				animation-delay: 1.1s;
			}
			& .ri-btn {
				animation-name: invite-in, pulse;
				animation-delay: 1.4s;
			}

			& .reel-progress i {
				animation: progress var(--reel-loop) linear infinite paused;
			}
		}

		:global(.is-live) > .reel-media:not([data-has-video]),
		:global(.is-live) .reel-media:not([data-has-video]) {
			& :global(img),
			& .reel-invite > *,
			& .reel-progress i {
				animation-play-state: running;
			}
		}

		:global(.is-paused) .reel-media:not([data-has-video]) {
			& :global(img),
			& .reel-invite > *,
			& .reel-progress i {
				animation-play-state: paused;
			}
		}
	}

	@keyframes kenburns {
		from {
			scale: 1.02;
			translate: 0 0;
		}
		to {
			scale: 1.18;
			translate: -3% 2%;
		}
	}

	@keyframes invite-in {
		0% {
			opacity: 0;
			translate: 0 1.2em;
			filter: blur(6px);
		}
		10%,
		88% {
			opacity: 1;
			translate: 0 0;
			filter: blur(0);
		}
		100% {
			opacity: 0;
			translate: 0 -0.4em;
		}
	}

	@keyframes pulse {
		0%,
		30%,
		50%,
		100% {
			scale: 1;
		}
		40% {
			scale: 1.08;
		}
	}

	@keyframes progress {
		from {
			scale: 0 1;
		}
		to {
			scale: 1 1;
		}
	}
</style>
