---
import { getSteps } from '../data/content';
import { getLang } from '../i18n';

const steps = getSteps(getLang(Astro.url));
---

<ol class="steps" role="list">
	{
		steps.map((s, i) => (
			<li class="step reveal">
				<span class="step-num" aria-hidden="true">
					{String(i + 1).padStart(2, '0')}
				</span>
				<h3>{s.title}</h3>
				<p>{s.text}</p>
			</li>
		))
	}
</ol>

<style>
	.steps {
		display: grid;
		grid-template-columns: 1fr;
		gap: 0.75rem;

		/* 4 pasos: 2×2 en tablet, en fila en escritorio */
		@media (width >= 36rem) {
			grid-template-columns: repeat(2, 1fr);
			gap: 1.25rem;
		}

		@media (width >= 64rem) {
			grid-template-columns: repeat(4, 1fr);
		}
		padding: 0;
		margin: 0;
		list-style: none;
		counter-reset: step;
	}

	.step {
		position: relative;
		padding: 1.75rem 1.5rem 1.5rem;
		border-radius: var(--radius-m);
		background: var(--paper);
		border: 1px solid var(--line);

		& h3 {
			margin-block: 0.75rem 0.4rem;
		}

		& p {
			margin: 0;
			color: var(--ink-soft);
			font-size: var(--step--1);
		}
	}

	/* Celular: número a la izquierda */
	@media (width < 36rem) {
		.step {
			display: grid;
			grid-template-columns: 3.25rem 1fr;
			padding: 1.1rem 1.1rem 1.1rem 0.9rem;

			& .step-num {
				grid-row: 1 / span 2;
				font-size: var(--step-3);
			}

			& h3 {
				margin-block: 0.1rem 0.25rem;
			}
		}
	}

	.step-num {
		font-family: var(--font-script);
		font-size: var(--step-4);
		font-weight: 600;
		line-height: 0.8;
		color: var(--sky-strong);
	}
</style>
