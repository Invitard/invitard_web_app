---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { url, whatsappLink } from '../data/site';
import { getLang, routes, langMeta } from '../i18n';

interface Props {
	/** Enlace (con base path) a esta misma página en el otro idioma. */
	altHref?: string;
}

const lang = getLang(Astro.url);
const other = lang === 'es' ? 'en' : 'es';
const home = routes.home[lang];
const { altHref = url(routes.home[other]) } = Astro.props;

const copy = {
	es: {
		links: [
			{ href: url(routes.categories.es), label: 'Categorías', match: routes.categories.es },
			{ href: url('/#shorts'), label: 'Shorts' },
			{ href: url('/#planes'), label: 'Planes' },
			{ href: url('/#proceso'), label: 'Cómo funciona' },
			{ href: url('/#preguntas'), label: 'Preguntas' },
		],
		home: 'Invitard, ir al inicio',
		menu: 'Menú',
		nav: 'Principal',
		quote: 'Cotizar',
		message: '¡Hola Invitard! Quiero cotizar una invitación digital ✨',
		switchLabel: 'Read in English',
	},
	en: {
		links: [
			{ href: url(routes.categories.en), label: 'Categories', match: routes.categories.en },
			{ href: url(`${home}#shorts`), label: 'Shorts' },
			{ href: url(`${home}#planes`), label: 'Pricing' },
			{ href: url(`${home}#proceso`), label: 'How it works' },
			{ href: url(`${home}#preguntas`), label: 'FAQ' },
		],
		home: 'Invitard, go to home page',
		menu: 'Menu',
		nav: 'Main',
		quote: 'Get a quote',
		message: 'Hi Invitard! I’d like a quote for a digital invitation ✨',
		switchLabel: 'Ver en español',
	},
}[lang];

const current = Astro.url.pathname;
const isCurrent = (match?: string) => (match ? current.startsWith(url(match)) : false);
---

<header class="site-header">
	<div class="header-inner container">
		<a class="site-logo" href={url(home)} aria-label={copy.home}>
			<Logo />
		</a>

		<nav class="site-nav" aria-label={copy.nav}>
			<a class="lang-switch" href={altHref} hreflang={other} lang={other} data-lang={other} aria-label={copy.switchLabel}>
				{langMeta[other].short}
			</a>
			<button class="menu-button" type="button" popovertarget="site-menu" popovertargetaction="toggle" aria-controls="site-menu">
				<Icon name="menu" size="1.35rem" />
				<span>{copy.menu}</span>
			</button>

			<ul id="site-menu" class="site-menu" popover="auto">
				{
					copy.links.map((l) => (
						<li>
							<a href={l.href} aria-current={isCurrent(l.match) ? 'page' : undefined}>
								{l.label}
							</a>
						</li>
					))
				}
				<li class="menu-cta">
					<a class="btn btn--whatsapp" href={whatsappLink(copy.message)} rel="noopener" target="_blank">
						<Icon name="whatsapp" />
						{copy.quote}
					</a>
				</li>
			</ul>
		</nav>
	</div>
</header>

<style>
	.site-header {
		position: sticky;
		inset-block-start: 0;
		z-index: 50;
		background: oklch(0.99 0.006 220 / 0.86);
		backdrop-filter: blur(14px) saturate(1.4);
		border-block-end: 1px solid var(--line);
	}

	.header-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		min-block-size: 4.5rem;
	}

	/* Mantiene medible el ancho natural de la fila */
	.header-inner > * {
		flex-shrink: 0;
		white-space: nowrap;
	}

	.site-logo {
		display: block;

		& :global(.logo) {
			--logo-bg: var(--paper);
			inline-size: clamp(7.5rem, 6.5rem + 3vw, 9rem);
		}
	}

	.site-nav {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.lang-switch {
		display: grid;
		place-items: center;
		min-inline-size: 2.75rem;
		min-block-size: 2.75rem;
		padding-inline: 0.6rem;
		border-radius: 999px;
		background: var(--paper-2);
		border: 1px solid var(--line);
		color: var(--ink);
		font-size: 0.85rem;
		font-weight: 700;
		letter-spacing: 0.04em;
		text-decoration: none;

		&:hover {
			background: var(--sky);
		}
	}

	.menu-button {
		anchor-name: --menu-button;
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		min-block-size: 2.75rem;
		padding-inline: 1rem;
		border: 2px solid var(--ink);
		border-radius: 999px;
		background: transparent;
		color: var(--ink);
		font: inherit;
		font-weight: 600;
		cursor: pointer;
	}

	/* ── Diseño estrecho: menú en popover ── */
	.site-menu {
		position: fixed;
		inset: auto;
		/* Sin anchor positioning se queda este valor */
		inset-block-start: 4.75rem;
		inset-block-start: anchor(--menu-button bottom);
		inset-inline-end: 1rem;
		inline-size: min(80dvw, 22rem);
		max-inline-size: calc(100dvw - 2rem);
		block-size: fit-content;
		max-block-size: calc(100dvh - 6rem);
		margin: 0.5rem 0 0;
		padding: 0.75rem;
		overflow: auto;
		list-style: none;
		border: 1px solid var(--line);
		border-radius: var(--radius-m);
		background: var(--paper);
		box-shadow: var(--shadow-m);

		& a:not(.btn) {
			display: block;
			padding: 0.75rem 1rem;
			border-radius: var(--radius-s);
			color: var(--ink);
			text-decoration: none;
			font-weight: 550;

			&:hover {
				background: var(--paper-2);
			}
		}

		& a[aria-current='page'] {
			text-decoration: underline;
			text-decoration-thickness: 3px;
			text-decoration-color: var(--sky-strong);
		}

		& .menu-cta {
			margin-block-start: 0.5rem;

			& .btn {
				inline-size: 100%;
			}
		}

		@media (prefers-reduced-motion: no-preference) {
			transition:
				opacity 0.2s ease-out,
				translate 0.2s ease-out,
				display 0.2s,
				overlay 0.2s;
			transition-behavior: allow-discrete;
		}
	}

	.site-menu:is(:popover-open, .\:popover-open) {
		opacity: 1;
		translate: 0 0;

		@starting-style {
			opacity: 0;
			translate: 0 -0.5rem;
		}
	}

	.site-menu:not(:is(:popover-open, .\:popover-open)) {
		opacity: 0;
		translate: 0 -0.5rem;
	}

	/* ── Diseño ancho: navegación en línea ── */
	.site-header:global(.is-wide) {
		& .menu-button {
			display: none;
		}

		& .site-menu {
			position: static;
			display: flex;
			align-items: center;
			gap: 0.15rem;
			inline-size: auto;
			max-inline-size: none;
			block-size: auto;
			max-block-size: none;
			overflow: visible;
			margin: 0;
			padding: 0;
			border: 0;
			background: transparent;
			box-shadow: none;
			opacity: 1;
			translate: none;

			& a:not(.btn) {
				padding: 0.5rem 0.8rem;
			}

			& .menu-cta {
				margin: 0 0 0 0.5rem;
			}
		}

		& .site-menu::backdrop {
			display: none;
		}
	}

	.site-header:global(.is-measuring) * {
		transition: none !important;
	}

	@media (forced-colors: active) {
		.site-menu a[aria-current='page'] {
			text-decoration-color: LinkText;
		}
	}
</style>

<script>
	// Feature detect: polyfill de popover solo si falta soporte nativo.
	if (!Object.hasOwn(HTMLElement.prototype, 'popover')) {
		// @ts-ignore: carga opcional desde CDN
		import(/* @vite-ignore */ 'https://unpkg.com/@oddbird/popover-polyfill@0.5.2/dist/popover.min.js');
	}

	const header = document.querySelector<HTMLElement>('.site-header');
	const inner = header?.querySelector<HTMLElement>('.header-inner');
	const menu = header?.querySelector<HTMLElement>('#site-menu');

	if (header && inner && menu) {
		let lastWidth = 0;

		const sync = () => {
			const width = header.clientWidth;
			const wide = header.classList.contains('is-wide');
			// En modo colapsado solo se vuelve a medir cuando el header crece.
			if (!wide && width <= lastWidth) {
				lastWidth = width;
				return;
			}
			lastWidth = width;

			const wasOpen = menu.matches(':popover-open, .\\:popover-open');
			header.classList.add('is-measuring', 'is-wide');
			menu.removeAttribute('popover');
			const fits = inner.scrollWidth <= inner.clientWidth;

			if (!fits) {
				header.classList.remove('is-wide');
				menu.setAttribute('popover', 'auto');
				if (wasOpen) menu.showPopover();
			}
			requestAnimationFrame(() => header.classList.remove('is-measuring'));
		};

		const ro = new ResizeObserver(sync);
		ro.observe(header);
		ro.observe(menu);

		// Guarda el idioma elegido a mano para no volver a redirigir.
		header.querySelector<HTMLAnchorElement>('.lang-switch')?.addEventListener('click', (e) => {
			try {
				localStorage.setItem('invitard:lang', (e.currentTarget as HTMLElement).dataset.lang!);
			} catch {
				/* almacenamiento no disponible */
			}
		});

		// Cierra el menú al elegir un ancla dentro de la misma página.
		menu.addEventListener('click', (e) => {
			if ((e.target as HTMLElement).closest('a') && menu.hasAttribute('popover')) menu.hidePopover();
		});
	}
</script>
