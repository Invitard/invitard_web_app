---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { groups, categoriesByGroup, categoryPath } from '../data/categories';
import { site, url, whatsappLink } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="container footer-grid">
		<div class="footer-brand">
			<div class="footer-logo"><Logo label="Invitard, invitaciones digitales" /></div>
			<p>
				Diseñamos invitaciones digitales web para bodas, quinceaños, cumpleaños, sacramentos, fiestas tradicionales y eventos
				institucionales. Desde {site.city} para todo el Perú y el mundo.
			</p>
			<a class="btn btn--whatsapp" href={whatsappLink('¡Hola Invitard! Quiero información sobre sus invitaciones digitales')} rel="noopener" target="_blank">
				<Icon name="whatsapp" />
				{site.whatsappDisplay}
			</a>
		</div>

		{
			groups.map((g) => (
				<nav class="footer-col" aria-labelledby={`footer-${g.id}`}>
					<h2 id={`footer-${g.id}`}>{g.name}</h2>
					<ul>
						{categoriesByGroup(g.id).map((c) => (
							<li>
								<a href={url(categoryPath(c))}>Invitaciones de {c.name.toLowerCase()}</a>
							</li>
						))}
					</ul>
				</nav>
			))
		}
	</div>

	<div class="container footer-bottom">
		<p>© {year} {site.name}. Invitaciones digitales hechas con cariño.</p>
		<ul class="social" aria-label="Redes sociales">
			<li><a href={site.social.instagram} rel="noopener me" target="_blank"><Icon name="instagram" size="1.25rem" /><span class="visually-hidden">Instagram</span></a></li>
			<li><a href={site.social.facebook} rel="noopener me" target="_blank"><Icon name="facebook" size="1.25rem" /><span class="visually-hidden">Facebook</span></a></li>
			<li><a href={site.social.tiktok} rel="noopener me" target="_blank"><Icon name="tiktok" size="1.25rem" /><span class="visually-hidden">TikTok</span></a></li>
			<li><a href={`mailto:${site.email}`}><Icon name="mail" size="1.25rem" /><span class="visually-hidden">Correo</span></a></li>
		</ul>
	</div>
</footer>

<style>
	.site-footer {
		background: var(--ink);
		color: oklch(0.9 0.01 250);
		padding-block: clamp(3rem, 2rem + 4vw, 5rem) 1.5rem;
		font-size: var(--step--1);

		& a:not(.btn) {
			color: inherit;
		}
	}

	.footer-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
		gap: 2.5rem 2rem;
	}

	.footer-brand {
		grid-column: 1 / -1;
		max-inline-size: 34rem;

		& .footer-logo {
			inline-size: 11rem;
			padding: 0.6rem 0.9rem;
			margin-block-end: 1rem;
			border-radius: var(--radius-s);
			background: white;
		}

		& p {
			font-size: var(--step-0);
		}
	}

	@media (width >= 64rem) {
		.footer-grid {
			grid-template-columns: 1.4fr repeat(4, 1fr);
		}

		.footer-brand {
			grid-column: auto;
		}
	}

	.footer-col {
		& h2 {
			font-size: var(--step-0);
			color: var(--sky);
			margin-block-end: 0.75rem;
		}

		& ul {
			list-style: none;
			margin: 0;
			padding: 0;
			display: grid;
			gap: 0.15rem;
		}

		& a {
			display: inline-block;
			padding-block: 0.3rem;
			text-decoration: none;

			&:hover {
				text-decoration: underline;
			}
		}
	}

	.footer-bottom {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		align-items: center;
		gap: 1rem;
		margin-block-start: 3rem;
		padding-block-start: 1.5rem;
		border-block-start: 1px solid oklch(1 0 0 / 0.12);

		& p {
			margin: 0;
		}
	}

	.social {
		display: flex;
		gap: 0.5rem;
		list-style: none;
		margin: 0;
		padding: 0;

		& a {
			display: grid;
			place-items: center;
			inline-size: 2.75rem;
			block-size: 2.75rem;
			border-radius: 50%;
			border: 1px solid oklch(1 0 0 / 0.2);

			&:hover {
				background: oklch(1 0 0 / 0.1);
			}
		}
	}
</style>
