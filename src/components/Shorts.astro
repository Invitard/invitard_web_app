---
/**
 * Shorts: el catálogo de modelos en video. Una fila infinita de tarjetas verticales
 * que avanza sola, con buscador por categoría, y al tocar una tarjeta un visor a
 * pantalla completa con scroll vertical tipo TikTok.
 */
import Icon from './Icon.astro';
import ShortMedia from './ShortMedia.astro';
import type { Short } from '../data/shorts';
import { getCategories, categoryPath } from '../data/categories';
import { url, whatsappLink } from '../data/site';
import { getLang } from '../i18n';

interface Props {
	shorts: Short[];
	id?: string;
	kicker?: string;
	title: string;
	lead?: string;
	/** Muestra el buscador y los filtros por categoría. */
	searchable?: boolean;
}

const lang = getLang(Astro.url);
const copy = {
	es: {
		kicker: 'Míralos en acción',
		watch: 'Ver shorts',
		prev: 'Anterior',
		next: 'Siguiente',
		searchLabel: 'Buscar shorts por tipo de evento',
		searchPlaceholder: 'Busca: boda, cumpleaños, bautizo…',
		all: 'Todos',
		filters: 'Filtrar por categoría',
		empty: 'No encontramos shorts para esa búsqueda.',
		emptyCta: 'Pídenos un diseño a medida',
		emptyMessage: '¡Hola Invitard! Busco una invitación que no vi en sus shorts ✨',
		cardLabel: (title: string, cat: string) => `Ver short: modelo «${title}» de ${cat.toLowerCase()}`,
		slideLabel: (title: string, i: number, n: number) => `Modelo «${title}», ${i} de ${n}`,
		message: (title: string, cat: string) => `¡Hola Invitard! Vi el short del modelo «${title}» (${cat}). ¿Me envían una demo? ✨`,
		model: (title: string) => `Modelo «${title}»`,
		want: 'Quiero una así',
		like: 'Me gusta',
		share: 'Compartir',
		demo: 'Pedir demo',
		mute: 'Silenciar',
		close: 'Cerrar shorts',
		prevShort: 'Short anterior',
		nextShort: 'Short siguiente',
		swipe: 'Desliza para ver más',
		copied: 'Enlace copiado',
		shareTitle: (title: string) => `Invitación digital «${title}» · Invitard`,
		results: (n: number) => (n === 1 ? '1 short' : `${n} shorts`),
	},
	en: {
		kicker: 'See them in action',
		watch: 'Watch shorts',
		prev: 'Previous',
		next: 'Next',
		searchLabel: 'Search shorts by event type',
		searchPlaceholder: 'Search: wedding, birthday, baptism…',
		all: 'All',
		filters: 'Filter by category',
		empty: 'No shorts match that search.',
		emptyCta: 'Ask us for a custom design',
		emptyMessage: 'Hi Invitard! I’m looking for an invitation I didn’t see in your shorts ✨',
		cardLabel: (title: string, cat: string) => `Watch short: “${title}” ${cat.toLowerCase()} design`,
		slideLabel: (title: string, i: number, n: number) => `“${title}” design, ${i} of ${n}`,
		message: (title: string, cat: string) => `Hi Invitard! I saw the “${title}” short (${cat}). Could you send me a demo? ✨`,
		model: (title: string) => `“${title}” design`,
		want: 'I want one like this',
		like: 'Like',
		share: 'Share',
		demo: 'Get a demo',
		mute: 'Mute',
		close: 'Close shorts',
		prevShort: 'Previous short',
		nextShort: 'Next short',
		swipe: 'Swipe up for more',
		copied: 'Link copied',
		shareTitle: (title: string) => `“${title}” digital invitation · Invitard`,
		results: (n: number) => (n === 1 ? '1 short' : `${n} shorts`),
	},
}[lang];

const { shorts, id = 'shorts', kicker = copy.kicker, title, lead, searchable = false } = Astro.props;
const titleId = `${id}-title`;
const categories = getCategories(lang);
const catOf = (s: Short) => categories.find((c) => c.slug === s.categorySlug)!;

// Categorías presentes, en el orden del catálogo, para los filtros rápidos.
const chipCats = categories.filter((c) => shorts.some((s) => s.categorySlug === c.slug));

// Texto en el que busca el buscador (sin tildes, en minúsculas). Incluye ambos idiomas de la categoría
// para que «boda» o «wedding» funcionen en cualquier versión.
const fold = (t: string) => t.normalize('NFD').replace(/\p{M}/gu, '').toLowerCase();
const allCats = { es: getCategories('es'), en: getCategories('en') };
const haystack = (s: Short) => {
	const names = [allCats.es, allCats.en].map((list) => list.find((c) => c.slug === s.categorySlug)!);
	return fold(
		[s.categorySlug, ...names.flatMap((c) => [c.name, c.eventLabel, ...c.keywords]), s.title, s.names, s.script, s.caption, ...s.tags].join(' '),
	);
};
---

<section class="shorts" {id} aria-labelledby={titleId} data-shorts data-copied={copy.copied}>
	<div class="container shorts-head">
		<div>
			<span class="kicker">{kicker}</span>
			<h2 id={titleId}>{title}</h2>
			{lead && <p>{lead}</p>}
		</div>
		<div class="shorts-head-actions">
			<button class="btn btn--sky shorts-open-all" type="button" data-open-first>
				<Icon name="play" />
				{copy.watch}
			</button>
			<div class="shelf-nav">
				<button type="button" class="round-btn" data-shelf="-1" aria-label={copy.prev}><Icon name="arrow" class="flip" /></button>
				<button type="button" class="round-btn" data-shelf="1" aria-label={copy.next}><Icon name="arrow" /></button>
			</div>
		</div>
	</div>

	{
		searchable && (
			<div class="container shorts-search">
				<label class="search-box">
					<Icon name="search" size="1.25rem" />
					<span class="visually-hidden">{copy.searchLabel}</span>
					<input type="search" data-search placeholder={copy.searchPlaceholder} autocomplete="off" enterkeyhint="search" />
				</label>
				<div class="chips-row" role="group" aria-label={copy.filters}>
					<button type="button" class="chip" data-chip="" aria-pressed="true">
						{copy.all}
					</button>
					{chipCats.map((c) => (
						<button
							type="button"
							class="chip"
							data-chip={c.slug}
							data-names={[c.slug, ...[allCats.es, allCats.en].map((l) => l.find((x) => x.slug === c.slug)!.name)].map(fold).join('|')}
							aria-pressed="false"
						>
							{c.name}
						</button>
					))}
				</div>
				<p class="visually-hidden" aria-live="polite" data-results data-one={copy.results(1)} data-many={copy.results(2)} />
			</div>
		)
	}

	<ul class="shelf" role="list" data-shelf-list>
		{
			shorts.map((s) => {
				const cat = catOf(s);
				return (
					<li class="short-card" data-id={s.id} data-cat={s.categorySlug} data-text={haystack(s)}>
						<button class="short-card-btn" type="button" data-open={s.id} aria-label={copy.cardLabel(s.title, cat.name)}>
							<ShortMedia short={s} widths={[240, 360, 480]} sizes="(width >= 46rem) 15rem, 44vw" />
							<span class="short-card-play" aria-hidden="true">
								<Icon name="play" size="1.1rem" />
							</span>
							<span class="short-card-meta" aria-hidden="true">
								<span class="short-card-cat">{cat.name}</span>
								<span class="short-card-title">{s.title}</span>
							</span>
						</button>
					</li>
				);
			})
		}
	</ul>

	<div class="container shorts-empty" data-empty hidden>
		<p>{copy.empty}</p>
		<a class="btn btn--whatsapp" href={whatsappLink(copy.emptyMessage)} rel="noopener" target="_blank">
			<Icon name="whatsapp" />
			{copy.emptyCta}
		</a>
	</div>

	<dialog class="viewer" aria-label={title}>
		<div class="feed" data-feed>
			{
				shorts.map((s, i) => {
					const cat = catOf(s);
					const message = copy.message(s.title, cat.name);
					return (
						<article
							class="slide"
							id={`short-${s.id}`}
							data-id={s.id}
							data-share-title={copy.shareTitle(s.title)}
							aria-label={copy.slideLabel(s.title, i + 1, shorts.length)}
						>
							<div class="slide-frame" data-tap>
								<ShortMedia short={s} widths={[480, 720, 1080]} sizes="(min-aspect-ratio: 3/4) 56vh, 100vw" />
								<span class="slide-paused" aria-hidden="true">
									<Icon name="play" size="2.2rem" />
								</span>
								<div class="slide-info">
									<a class="slide-cat" href={url(categoryPath(cat, lang))}>
										{cat.name}
									</a>
									<h3>{copy.model(s.title)}</h3>
									<p>{s.caption}</p>
									<ul class="slide-tags" role="list">
										{s.tags.map((t) => (
											<li>#{t.replace(/\s+(\S)/g, (_, ch: string) => ch.toUpperCase())}</li>
										))}
									</ul>
									<a class="btn btn--whatsapp slide-cta" href={whatsappLink(message)} rel="noopener" target="_blank">
										<Icon name="whatsapp" />
										{copy.want}
									</a>
								</div>
							</div>
							<div class="slide-rail">
								<button type="button" class="rail-btn" data-like aria-pressed="false">
									<span class="rail-icon">
										<Icon name="heartFill" size="1.6rem" />
									</span>
									<span class="rail-label">{copy.like}</span>
								</button>
								<button type="button" class="rail-btn" data-share>
									<span class="rail-icon">
										<Icon name="share" size="1.5rem" />
									</span>
									<span class="rail-label">{copy.share}</span>
								</button>
								<a class="rail-btn rail-btn--wa" href={whatsappLink(message)} rel="noopener" target="_blank">
									<span class="rail-icon">
										<Icon name="whatsapp" size="1.5rem" />
									</span>
									<span class="rail-label">{copy.demo}</span>
								</a>
							</div>
						</article>
					);
				})
			}
		</div>

		<div class="viewer-top">
			<button type="button" class="round-btn round-btn--glass" data-mute hidden aria-pressed="false">
				<span class="when-muted"><Icon name="muted" size="1.3rem" /></span>
				<span class="when-sound"><Icon name="volume" size="1.3rem" /></span>
				<span class="visually-hidden">{copy.mute}</span>
			</button>
			<span class="viewer-count" aria-live="polite"><span data-count>1</span> / <span data-total>{shorts.length}</span></span>
			<form method="dialog">
				<button class="round-btn round-btn--glass" aria-label={copy.close}>
					<Icon name="close" size="1.4rem" />
				</button>
			</form>
		</div>

		<div class="viewer-nav">
			<button type="button" class="round-btn round-btn--glass" data-step="-1" aria-label={copy.prevShort}>
				<Icon name="up" size="1.4rem" />
			</button>
			<button type="button" class="round-btn round-btn--glass" data-step="1" aria-label={copy.nextShort}>
				<Icon name="down" size="1.4rem" />
			</button>
		</div>

		<div class="swipe-hint" aria-hidden="true">
			<Icon name="up" size="1.8rem" />
			{copy.swipe}
		</div>
		<div class="toast" role="status" aria-live="polite"></div>
	</dialog>
</section>

<style>
	/* ───────── Sección ───────── */
	.shorts {
		--glow-1: oklch(0.55 0.17 20 / 0.45);
		--glow-2: oklch(0.55 0.14 235 / 0.5);
		position: relative;
		overflow: clip;
		padding-block: clamp(3.5rem, 2.5rem + 4vw, 6rem);
		color: white;
		background:
			radial-gradient(ellipse 50% 60% at 10% 0%, var(--glow-1), transparent 70%),
			radial-gradient(ellipse 50% 70% at 95% 100%, var(--glow-2), transparent 70%),
			oklch(0.18 0.025 275);
	}

	.shorts-head {
		display: flex;
		flex-wrap: wrap;
		align-items: end;
		justify-content: space-between;
		gap: 1.25rem 2rem;
		margin-block-end: clamp(1.5rem, 1rem + 2vw, 2.5rem);

		& > div:first-child {
			max-inline-size: 42rem;
		}

		& h2 {
			margin-block-end: 0.35em;
		}

		& p {
			margin: 0;
			font-size: var(--step-1);
			line-height: 1.5;
			color: oklch(0.88 0.02 260);
		}

		& .kicker {
			color: var(--sky);
		}
	}

	.shorts-head-actions {
		display: flex;
		align-items: center;
		gap: 0.75rem;

		@media (width < 46rem) {
			inline-size: 100%;

			& .shorts-open-all {
				flex: 1;
			}
		}
	}

	.shelf-nav {
		display: none;
		gap: 0.5rem;

		@media (width >= 46rem) and (hover: hover) {
			display: flex;
		}
	}

	.round-btn {
		display: grid;
		place-items: center;
		inline-size: 3rem;
		block-size: 3rem;
		padding: 0;
		border: 1px solid oklch(1 0 0 / 0.25);
		border-radius: 50%;
		background: oklch(1 0 0 / 0.08);
		color: white;
		cursor: pointer;
		transition:
			background-color 0.2s,
			scale 0.2s;

		&:hover {
			background: oklch(1 0 0 / 0.2);
		}

		&:active {
			scale: 0.92;
		}

		&[hidden] {
			display: none;
		}

		& :global(.flip) {
			rotate: 180deg;
		}
	}

	.round-btn--glass {
		background: oklch(0.15 0.02 270 / 0.45);
		backdrop-filter: blur(10px);
	}

	/* ───────── Fila de tarjetas ───────── */
	.shelf {
		--card-w: clamp(9.5rem, 44vw, 15rem);
		display: grid;
		grid-auto-flow: column;
		grid-auto-columns: var(--card-w);
		gap: clamp(0.75rem, 0.5rem + 1vw, 1.25rem);
		margin: 0;
		padding: 0.75rem max(var(--gutter), (100% - var(--content)) / 2) 1.5rem;
		list-style: none;
		overflow-x: auto;
		overscroll-behavior-x: contain;
		scroll-snap-type: x mandatory;
		scroll-padding-inline: max(var(--gutter), (100% - var(--content)) / 2);
		scrollbar-width: none;

		&::-webkit-scrollbar {
			display: none;
		}
	}

	.short-card {
		scroll-snap-align: start;
	}

	.short-card-btn {
		position: relative;
		display: block;
		inline-size: 100%;
		aspect-ratio: 9 / 16;
		padding: 0;
		border: 0;
		border-radius: 1.25rem;
		overflow: clip;
		background: oklch(0.25 0.02 270);
		color: white;
		font: inherit;
		text-align: start;
		cursor: pointer;
		box-shadow:
			0 0 0 1px oklch(1 0 0 / 0.12),
			0 24px 40px -20px oklch(0 0 0 / 0.7);
		transition:
			translate 0.3s cubic-bezier(0.2, 0.8, 0.2, 1),
			box-shadow 0.3s;

		&:hover,
		&:focus-visible {
			translate: 0 -6px;
			box-shadow:
				0 0 0 2px var(--sky),
				0 30px 50px -20px oklch(0 0 0 / 0.8);
		}

		/* En la fila la invitación va más simple: sin contador ni botón */
		& :global(.ri-btn),
		& :global(.ri-count) {
			display: none;
		}

		& :global(.reel-invite) {
			padding-block-end: 34%;
		}
	}

	.short-card-play {
		position: absolute;
		inset-block-start: 1.1rem;
		inset-inline-end: 0.7rem;
		z-index: 2;
		display: grid;
		place-items: center;
		inline-size: 2rem;
		block-size: 2rem;
		border-radius: 50%;
		background: oklch(0 0 0 / 0.35);
		backdrop-filter: blur(6px);
		padding-inline-start: 2px;
	}

	.short-card-meta {
		position: absolute;
		inset: auto 0 0;
		z-index: 2;
		display: grid;
		gap: 0.1rem;
		padding: 2rem 0.8rem 0.8rem;
		background: linear-gradient(transparent, oklch(0.1 0.02 270 / 0.85));
		line-height: 1.2;
	}

	.short-card-cat {
		inline-size: fit-content;
		max-inline-size: 100%;
		overflow: hidden;
		white-space: nowrap;
		text-overflow: ellipsis;
		padding: 0.1rem 0.55rem;
		border-radius: 999px;
		background: oklch(1 0 0 / 0.2);
		backdrop-filter: blur(6px);
		font-size: 0.72rem;
		font-weight: 600;
	}

	.short-card-title {
		font-weight: 700;
		font-size: 0.95rem;
	}

	/* ───────── Visor a pantalla completa ───────── */
	.viewer {
		position: fixed;
		inset: 0;
		inline-size: 100%;
		block-size: 100dvh;
		max-inline-size: none;
		max-block-size: none;
		margin: 0;
		padding: 0;
		border: 0;
		background: oklch(0.12 0.02 275);
		color: white;
		overflow: hidden;

		&::backdrop {
			background: oklch(0.1 0.02 275);
		}

		@media (prefers-reduced-motion: no-preference) {
			&[open] {
				animation: viewer-in 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
			}
		}
	}

	@keyframes viewer-in {
		from {
			opacity: 0;
			scale: 0.96;
		}
	}

	:global(html:has(.viewer[open])) {
		overflow: hidden;
	}

	.feed {
		block-size: 100%;
		overflow-y: auto;
		overscroll-behavior: contain;
		scroll-snap-type: y mandatory;
		scrollbar-width: none;

		&::-webkit-scrollbar {
			display: none;
		}
	}

	.slide {
		position: relative;
		display: grid;
		place-items: center;
		block-size: 100%;
		scroll-snap-align: start;
		scroll-snap-stop: always;
	}

	.slide-frame {
		position: absolute;
		inset: 0;
		overflow: clip;
		cursor: pointer;
		-webkit-tap-highlight-color: transparent;

		& :global(.reel-progress) {
			inset-block-start: max(0.6rem, env(safe-area-inset-top));
		}

		& :global(.reel-invite) {
			padding-block-end: 58%;
		}

		& :global(.ri-btn) {
			display: none;
		}
	}

	/* Pantallas anchas: el reel es un celular centrado, como en TikTok web */
	@media (min-aspect-ratio: 3/4) {
		.slide {
			grid-template-columns: auto auto;
			justify-content: center;
			align-items: end;
			gap: 1.25rem;
			padding-block: 1.5rem;
		}

		.slide-frame {
			position: relative;
			inset: auto;
			block-size: calc(100dvh - 3rem);
			aspect-ratio: 9 / 16;
			border-radius: 1.5rem;
			box-shadow: 0 0 0 1px oklch(1 0 0 / 0.1);

			& :global(.reel-invite) {
				padding-block-end: 52%;
			}
		}
	}

	.slide-paused {
		position: absolute;
		inset: 0;
		z-index: 3;
		display: grid;
		place-items: center;
		pointer-events: none;
		opacity: 0;
		transition: opacity 0.2s;

		& :global(svg) {
			box-sizing: content-box;
			padding: 1.1rem 1rem 1.1rem 1.2rem;
			border-radius: 50%;
			background: oklch(0 0 0 / 0.4);
		}
	}

	:global(.is-paused) > .slide-paused {
		opacity: 1;
	}

	.slide-info {
		position: absolute;
		inset: auto 0 0;
		z-index: 2;
		padding: 5rem 5rem max(1.25rem, env(safe-area-inset-bottom)) 1rem;
		background: linear-gradient(transparent, oklch(0.08 0.02 270 / 0.92) 55%);
		cursor: auto;

		& h3 {
			margin-block: 0.5rem 0.25rem;
			font-size: 1.2rem;
		}

		& p {
			margin-block-end: 0.5rem;
			font-size: 0.92rem;
			line-height: 1.45;
			color: oklch(0.92 0.01 260);
		}

		@media (min-aspect-ratio: 3/4) {
			padding-inline-end: 1rem;
		}
	}

	.slide-cat {
		display: inline-block;
		padding: 0.15rem 0.7rem;
		border-radius: 999px;
		background: oklch(1 0 0 / 0.18);
		backdrop-filter: blur(6px);
		color: white;
		font-size: 0.8rem;
		font-weight: 600;
		text-decoration: none;

		&:hover {
			background: oklch(1 0 0 / 0.3);
		}
	}

	.slide-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.2rem 0.6rem;
		margin: 0 0 0.9rem;
		padding: 0;
		list-style: none;
		font-size: 0.85rem;
		font-weight: 600;
		color: var(--sky);
	}

	.slide-cta {
		inline-size: 100%;
		min-block-size: 2.9rem;
	}

	/* Acciones laterales */
	.slide-rail {
		position: absolute;
		inset-inline-end: 0.6rem;
		inset-block-end: 11rem;
		z-index: 3;
		display: grid;
		gap: 1rem;

		@media (min-aspect-ratio: 3/4) {
			position: static;
			padding-block-end: 1rem;
		}
	}

	.rail-btn {
		display: grid;
		justify-items: center;
		gap: 0.25rem;
		padding: 0;
		border: 0;
		background: none;
		color: white;
		font: inherit;
		font-size: 0.72rem;
		font-weight: 600;
		text-decoration: none;
		cursor: pointer;
		text-shadow: 0 1px 4px oklch(0 0 0 / 0.5);
	}

	.rail-icon {
		display: grid;
		place-items: center;
		inline-size: 3rem;
		block-size: 3rem;
		border-radius: 50%;
		background: oklch(0.15 0.02 270 / 0.5);
		backdrop-filter: blur(8px);
		transition:
			scale 0.2s,
			background-color 0.2s,
			color 0.2s;

		.rail-btn:active & {
			scale: 0.88;
		}
	}

	.rail-btn[aria-pressed='true'] .rail-icon {
		color: oklch(0.68 0.22 18);
		background: white;

		@media (prefers-reduced-motion: no-preference) {
			animation: like-pop 0.4s cubic-bezier(0.2, 1.6, 0.4, 1);
		}
	}

	.rail-btn--wa .rail-icon {
		background: var(--whatsapp);
		color: var(--ink);
	}

	@keyframes like-pop {
		40% {
			scale: 1.3;
		}
	}

	/* Corazón al dar doble toque */
	:global(.burst) {
		position: absolute;
		z-index: 4;
		inline-size: 6rem;
		block-size: 6rem;
		margin: -3rem 0 0 -3rem;
		color: oklch(0.68 0.22 18);
		pointer-events: none;
		filter: drop-shadow(0 6px 16px oklch(0 0 0 / 0.4));
		animation: burst 0.8s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
	}

	@keyframes burst {
		0% {
			opacity: 0;
			scale: 0.3;
			rotate: -15deg;
		}
		25% {
			opacity: 1;
			scale: 1.15;
		}
		45% {
			scale: 0.95;
		}
		100% {
			opacity: 0;
			scale: 1.4;
			translate: 0 -40px;
		}
	}

	/* Barra superior y navegación */
	.viewer-top {
		position: absolute;
		inset: max(1.2rem, env(safe-area-inset-top)) 0.75rem auto;
		z-index: 5;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		pointer-events: none;

		& > * {
			pointer-events: auto;
		}

		& form {
			margin-inline-start: auto;
		}

		@media (min-aspect-ratio: 3/4) {
			inset-inline: 1.5rem;
		}
	}

	.viewer-count {
		font-size: 0.85rem;
		font-weight: 600;
		font-variant-numeric: tabular-nums;
		text-shadow: 0 1px 4px oklch(0 0 0 / 0.6);

		[data-mute][hidden] + & {
			margin-inline-start: 0.5rem;
		}
	}

	[data-mute] .when-sound,
	[data-mute][aria-pressed='false'] .when-muted {
		display: none;
	}

	[data-mute][aria-pressed='false'] .when-sound {
		display: block;
	}

	.viewer-nav {
		position: absolute;
		inset-inline-end: 1.5rem;
		inset-block-start: 50%;
		z-index: 5;
		display: none;
		gap: 0.75rem;
		translate: 0 -50%;

		@media (min-aspect-ratio: 3/4) {
			display: grid;
		}

		& button:disabled {
			opacity: 0.3;
			cursor: default;
		}
	}

	.swipe-hint {
		position: absolute;
		inset: 22% 0 auto;
		z-index: 4;
		display: none;
		justify-items: center;
		gap: 0.25rem;
		font-weight: 650;
		text-shadow: 0 1px 6px oklch(0 0 0 / 0.6);
		pointer-events: none;

		@media (pointer: coarse) {
			.viewer.show-hint & {
				display: grid;
			}
		}

		@media (prefers-reduced-motion: no-preference) {
			& :global(svg) {
				animation: nudge 1.2s ease-in-out infinite;
			}
		}
	}

	@keyframes nudge {
		50% {
			translate: 0 -10px;
		}
	}

	.toast {
		position: absolute;
		inset: auto 50% 2rem auto;
		z-index: 6;
		translate: 50% 0;
		padding: 0.6rem 1.1rem;
		border-radius: 999px;
		background: white;
		color: var(--ink);
		font-size: 0.9rem;
		font-weight: 600;
		opacity: 0;
		transition: opacity 0.25s;
		pointer-events: none;

		&.is-visible {
			opacity: 1;
		}
	}

	/* ───────── Buscador ───────── */
	.shorts-search {
		display: grid;
		gap: 0.9rem;
		margin-block-end: 1.25rem;
	}

	.search-box {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		max-inline-size: 34rem;
		padding-inline: 1.1rem;
		border-radius: 999px;
		background: oklch(1 0 0 / 0.1);
		border: 1px solid oklch(1 0 0 / 0.22);
		color: oklch(0.85 0.02 260);
		transition:
			background-color 0.2s,
			border-color 0.2s;

		&:focus-within {
			background: oklch(1 0 0 / 0.16);
			border-color: var(--sky);
		}

		& input {
			flex: 1;
			min-inline-size: 0;
			min-block-size: 3rem;
			border: 0;
			background: transparent;
			color: white;
			font: inherit;
			outline: none;

			&::placeholder {
				color: oklch(0.8 0.02 260);
			}
		}
	}

	.chips-row {
		display: flex;
		gap: 0.5rem;
		margin-inline: calc(-1 * var(--gutter));
		padding: 0.15rem var(--gutter);
		overflow-x: auto;
		scrollbar-width: none;

		&::-webkit-scrollbar {
			display: none;
		}
	}

	.chip {
		flex-shrink: 0;
		min-block-size: 2.5rem;
		padding: 0.35rem 1rem;
		border-radius: 999px;
		border: 1px solid oklch(1 0 0 / 0.22);
		background: transparent;
		color: white;
		font: inherit;
		font-size: var(--step--1);
		font-weight: 600;
		cursor: pointer;
		transition:
			background-color 0.2s,
			color 0.2s;

		&:hover {
			background: oklch(1 0 0 / 0.12);
		}

		&[aria-pressed='true'] {
			background: var(--sky);
			border-color: var(--sky);
			color: var(--ink);
		}
	}

	.shorts-empty {
		display: grid;
		justify-items: start;
		gap: 0.5rem;
		padding-block: 1rem 1.5rem;

		&[hidden] {
			display: none;
		}

		& p {
			margin: 0;
			font-size: var(--step-1);
			color: oklch(0.88 0.02 260);
		}
	}

	:global(.is-empty) > .shelf {
		display: none;
	}

	/* Carrusel infinito: sin imán para que el avance automático sea suave */
	.shelf:global(.is-looping) {
		scroll-snap-type: none;
	}

	.short-card[hidden] {
		display: none;
	}

	.slide[hidden] {
		display: none;
	}
</style>

<script>
	const LIKES_KEY = 'invitard:shorts-liked';
	const SPEED = 32; // px por segundo del carrusel automático
	const canHover = matchMedia('(hover: hover)').matches;
	const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

	const fold = (t: string) => t.normalize('NFD').replace(/\p{M}/gu, '').toLowerCase().trim();

	function loadLikes(): Set<string> {
		try {
			return new Set(JSON.parse(localStorage.getItem(LIKES_KEY) ?? '[]'));
		} catch {
			return new Set();
		}
	}

	function saveLikes(likes: Set<string>) {
		try {
			localStorage.setItem(LIKES_KEY, JSON.stringify([...likes]));
		} catch {
			/* almacenamiento no disponible */
		}
	}

	/** Reproduce el video de un contenedor (cargándolo la primera vez). */
	function playVideo(scope: Element, { muted = true, restart = false } = {}): HTMLVideoElement | null {
		const video = scope.querySelector<HTMLVideoElement>('.reel-video');
		if (!video) return null;
		if (!video.src && video.dataset.src) video.src = video.dataset.src;
		if (restart) video.currentTime = 0;
		video.muted = muted;
		video.play().catch(() => {
			// Si el navegador bloquea el sonido, reintenta en silencio.
			if (!video.muted) {
				video.muted = true;
				video.play().catch(() => {});
			}
		});
		return video;
	}

	function pauseVideo(scope: Element) {
		scope.querySelector<HTMLVideoElement>('.reel-video')?.pause();
	}

	document.addEventListener(
		'playing',
		(e) => {
			const v = e.target as HTMLElement;
			if (v.classList?.contains('reel-video')) v.classList.add('is-playing');
		},
		true,
	);

	const likes = loadLikes();

	for (const root of document.querySelectorAll<HTMLElement>('[data-shorts]')) {
		const shelf = root.querySelector<HTMLElement>('[data-shelf-list]')!;
		const originals = [...shelf.querySelectorAll<HTMLElement>('.short-card')];
		const viewer = root.querySelector<HTMLDialogElement>('.viewer')!;
		const feed = viewer.querySelector<HTMLElement>('[data-feed]')!;
		const allSlides = [...viewer.querySelectorAll<HTMLElement>('.slide')];
		const muteBtn = viewer.querySelector<HTMLButtonElement>('[data-mute]')!;
		const countEl = viewer.querySelector<HTMLElement>('[data-count]')!;
		const totalEl = viewer.querySelector<HTMLElement>('[data-total]')!;
		const stepBtns = [...viewer.querySelectorAll<HTMLButtonElement>('[data-step]')];
		const toast = viewer.querySelector<HTMLElement>('.toast')!;
		const search = root.querySelector<HTMLInputElement>('[data-search]');
		const chips = [...root.querySelectorAll<HTMLButtonElement>('[data-chip]')];
		const results = root.querySelector<HTMLElement>('[data-results]');
		const empty = root.querySelector<HTMLElement>('[data-empty]')!;

		let slides = allSlides; // los que coinciden con el filtro
		let active = -1;
		let muted = false;
		let historyMode: 'push' | 'replace' | null = null;

		/* ───────── Carrusel infinito ───────── */
		let looping = false;
		let loopWidth = 0;
		let pos = 0;
		let last = 0;
		let holdUntil = 0; // pausa temporal tras una interacción
		let hovering = false;
		let inView = false;

		const cardObserver = new IntersectionObserver(
			(entries) => {
				for (const e of entries) {
					const card = e.target as HTMLElement;
					card.classList.toggle('is-live', e.isIntersecting);
					if (canHover || reduceMotion) continue;
					if (e.isIntersecting) playVideo(card);
					else pauseVideo(card);
				}
			},
			{ threshold: 0.6 },
		);

		const visibleCards = () => originals.filter((c) => !c.hidden);

		/** Rehace los clones con las tarjetas visibles para que la fila no tenga fin. */
		function buildLoop() {
			shelf.querySelectorAll('.is-clone').forEach((c) => {
				cardObserver.unobserve(c.querySelector('button')!);
				c.remove();
			});
			const visible = visibleCards();
			shelf.scrollLeft = 0;
			pos = 0;
			looping = false;
			shelf.classList.remove('is-looping');
			if (visible.length === 0) return;

			// Solo hay bucle si las tarjetas ocupan más que el ancho visible.
			const lastCard = visible[visible.length - 1];
			const contentWidth = lastCard.offsetLeft + lastCard.offsetWidth - visible[0].offsetLeft;
			if (contentWidth <= shelf.clientWidth) return;

			for (const card of visible) {
				const clone = card.cloneNode(true) as HTMLElement;
				clone.classList.add('is-clone');
				clone.setAttribute('aria-hidden', 'true');
				clone.inert = true;
				clone.querySelector('.reel-video')?.removeAttribute('src');
				shelf.append(clone);
				cardObserver.observe(clone.querySelector('button')!);
			}
			const firstClone = shelf.querySelector<HTMLElement>('.is-clone')!;
			loopWidth = firstClone.offsetLeft - visible[0].offsetLeft;
			looping = true;
			shelf.classList.add('is-looping');
		}

		function wrap() {
			if (!looping) return;
			if (pos >= loopWidth) pos -= loopWidth;
			else if (pos < 1) pos += loopWidth;
		}

		function tick(now: number) {
			const dt = Math.min(0.05, (now - last) / 1000 || 0);
			last = now;
			const running = looping && !reduceMotion && inView && !hovering && !viewer.open && now > holdUntil && !document.hidden;
			if (running) {
				pos += SPEED * dt;
				wrap();
				shelf.scrollLeft = pos;
			}
			requestAnimationFrame(tick);
		}

		const hold = (ms = 3000) => (holdUntil = performance.now() + ms);

		shelf.addEventListener(
			'scroll',
			() => {
				// Si la persona desplaza a mano, seguimos desde donde dejó la fila.
				if (Math.abs(shelf.scrollLeft - pos) > 2) {
					pos = shelf.scrollLeft;
					if (looping && (pos >= loopWidth || pos < 1)) {
						wrap();
						shelf.scrollLeft = pos;
					}
				}
			},
			{ passive: true },
		);

		shelf.addEventListener('pointerenter', (e) => {
			if (e.pointerType === 'mouse') hovering = true;
		});
		shelf.addEventListener('pointerleave', () => (hovering = false));
		shelf.addEventListener('pointerdown', () => hold(4000), { passive: true });
		shelf.addEventListener('touchstart', () => hold(4000), { passive: true });
		shelf.addEventListener('wheel', () => hold(3000), { passive: true });
		shelf.addEventListener('focusin', () => hold(6000));

		new IntersectionObserver(([e]) => (inView = e.isIntersecting), { threshold: 0.2 }).observe(shelf);

		for (const card of originals) cardObserver.observe(card.querySelector('button')!);

		if (canHover && !reduceMotion) {
			shelf.addEventListener('pointerover', (e) => {
				const btn = (e.target as Element).closest<HTMLElement>('.short-card-btn');
				if (btn) playVideo(btn);
			});
			shelf.addEventListener('pointerout', (e) => {
				const btn = (e.target as Element).closest<HTMLElement>('.short-card-btn');
				if (btn && !btn.contains(e.relatedTarget as Node)) pauseVideo(btn);
			});
		}

		for (const btn of root.querySelectorAll<HTMLButtonElement>('[data-shelf]')) {
			btn.addEventListener('click', () => {
				hold(3500);
				const card = visibleCards()[0];
				const step = (card?.offsetWidth ?? 200) + 16;
				shelf.scrollBy({ left: Number(btn.dataset.shelf) * step * 2, behavior: reduceMotion ? 'instant' : 'smooth' });
			});
		}

		let resizeTimer = 0;
		new ResizeObserver(() => {
			clearTimeout(resizeTimer);
			resizeTimer = window.setTimeout(buildLoop, 150);
		}).observe(shelf);

		requestAnimationFrame((t) => {
			last = t;
			buildLoop();
			requestAnimationFrame(tick);
		});

		/* ───────── Buscador y filtros ───────── */
		let chipFilter = '';

		function applyFilter() {
			const query = fold(search?.value ?? '');
			// Si lo escrito es el nombre exacto de una categoría («cumpleaños», «wedding»…), mostramos solo esa.
			const exact = query && chips.find((c) => c.dataset.names?.split('|').some((n) => n === query || n.replace(/s$/, '') === query));
			if (search) chips.forEach((c) => c.setAttribute('aria-pressed', String(exact ? c === exact : query ? false : c.dataset.chip === chipFilter)));
			const words = exact ? [] : query.split(/\s+/).filter(Boolean);
			const catFilter = exact ? exact.dataset.chip! : chipFilter;
			let count = 0;
			for (const card of originals) {
				const text = card.dataset.text ?? '';
				const match = (!catFilter || card.dataset.cat === catFilter) && words.every((w) => text.includes(w));
				card.hidden = !match;
				if (match) count++;
			}
			const visibleIds = new Set(visibleCards().map((c) => c.dataset.id));
			for (const s of allSlides) s.hidden = !visibleIds.has(s.dataset.id);
			slides = allSlides.filter((s) => !s.hidden);
			totalEl.textContent = String(slides.length);
			empty.hidden = count > 0;
			root.classList.toggle('is-empty', count === 0);
			if (results) results.textContent = count === 1 ? results.dataset.one! : results.dataset.many!.replace(/\d+/, String(count));
			buildLoop();
		}

		search?.addEventListener('input', () => {
			hold(2000);
			chipFilter = '';
			applyFilter();
		});

		for (const chip of chips) {
			chip.addEventListener('click', () => {
				chipFilter = chip.dataset.chip ?? '';
				chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
				if (search) search.value = '';
				applyFilter();
			});
		}

		/* ───────── Visor a pantalla completa ───────── */
		function showToast(text: string) {
			toast.textContent = text;
			toast.classList.add('is-visible');
			setTimeout(() => toast.classList.remove('is-visible'), 1800);
		}

		function setActive(index: number) {
			if (index === active || index < 0) return;
			active = index;
			slides.forEach((s, i) => {
				const on = i === index;
				s.classList.toggle('is-live', on);
				s.querySelector('[data-tap]')!.classList.remove('is-paused');
				if (!on) pauseVideo(s);
			});
			// Carga ya la imagen del short actual y de sus vecinos.
			for (const s of slides.slice(Math.max(0, index - 1), index + 3)) {
				s.querySelectorAll('img[loading="lazy"]').forEach((img) => img.setAttribute('loading', 'eager'));
			}
			const slide = slides[index];
			const video = playVideo(slide, { muted, restart: true });
			muteBtn.hidden = !video;
			countEl.textContent = String(index + 1);
			stepBtns[0].disabled = index === 0;
			stepBtns[1].disabled = index === slides.length - 1;
			if (historyMode) history.replaceState(history.state, '', `#${slide.id}`);
		}

		const feedObserver = new IntersectionObserver(
			(entries) => {
				for (const e of entries) {
					if (e.isIntersecting) setActive(slides.indexOf(e.target as HTMLElement));
				}
			},
			{ root: feed, threshold: 0.6 },
		);
		allSlides.forEach((s) => feedObserver.observe(s));

		function open(id: string | undefined, { fromHash = false } = {}) {
			const index = Math.max(0, slides.findIndex((s) => s.dataset.id === id));
			if (!slides.length) return;
			active = -1;
			viewer.showModal();
			feed.scrollTo({ top: slides[index].offsetTop, behavior: 'instant' });
			setActive(index);
			viewer.classList.toggle('show-hint', index < slides.length - 1);
			if (fromHash) {
				historyMode = 'replace';
			} else {
				history.pushState({ shorts: true }, '', `#${slides[index].id}`);
				historyMode = 'push';
			}
		}

		shelf.addEventListener('click', (e) => {
			const btn = (e.target as Element).closest<HTMLElement>('[data-open]');
			if (btn) open(btn.dataset.open);
		});
		root.querySelector('[data-open-first]')?.addEventListener('click', () => open(slides[0]?.dataset.id));

		viewer.addEventListener('close', () => {
			allSlides.forEach((s) => {
				pauseVideo(s);
				s.classList.remove('is-live');
			});
			active = -1;
			hold(1500);
			const mode = historyMode;
			historyMode = null;
			if (mode === 'push') history.back();
			else if (mode === 'replace') history.replaceState(history.state, '', location.pathname + location.search);
		});

		// Botón «atrás» del celular: cierra el visor en lugar de salir de la página.
		addEventListener('popstate', () => {
			if (viewer.open) {
				historyMode = null;
				viewer.close();
			}
		});

		feed.addEventListener('scroll', () => viewer.classList.remove('show-hint'), { passive: true });

		function step(delta: number) {
			const next = Math.min(slides.length - 1, Math.max(0, active + delta));
			feed.scrollTo({ top: slides[next].offsetTop, behavior: reduceMotion ? 'instant' : 'smooth' });
		}

		stepBtns.forEach((b) => b.addEventListener('click', () => step(Number(b.dataset.step))));

		viewer.addEventListener('keydown', (e) => {
			if (e.key === 'ArrowDown' || e.key === 'PageDown' || e.key === 'j') {
				e.preventDefault();
				step(1);
			} else if (e.key === 'ArrowUp' || e.key === 'PageUp' || e.key === 'k') {
				e.preventDefault();
				step(-1);
			} else if (e.key === 'm') {
				muteBtn.click();
			}
		});

		muteBtn.addEventListener('click', () => {
			muted = !muted;
			muteBtn.setAttribute('aria-pressed', String(muted));
			const video = slides[active]?.querySelector<HTMLVideoElement>('.reel-video');
			if (video) video.muted = muted;
		});

		/* Me gusta (guardado en el navegador) */
		function setLiked(slide: HTMLElement, liked: boolean) {
			const id = slide.dataset.id!;
			if (liked) likes.add(id);
			else likes.delete(id);
			saveLikes(likes);
			slide.querySelector('[data-like]')!.setAttribute('aria-pressed', String(liked));
		}

		for (const slide of allSlides) {
			const likeBtn = slide.querySelector<HTMLButtonElement>('[data-like]')!;
			likeBtn.setAttribute('aria-pressed', String(likes.has(slide.dataset.id!)));
			likeBtn.addEventListener('click', () => setLiked(slide, likeBtn.getAttribute('aria-pressed') !== 'true'));

			slide.querySelector('[data-share]')!.addEventListener('click', async () => {
				const shareUrl = `${location.origin}${location.pathname}#${slide.id}`;
				try {
					if (navigator.share) await navigator.share({ title: slide.dataset.shareTitle, url: shareUrl });
					else {
						await navigator.clipboard.writeText(shareUrl);
						showToast(root.dataset.copied!);
					}
				} catch {
					/* compartir cancelado */
				}
			});

			// Toque: pausa / reanuda. Doble toque: me gusta con corazón.
			const frame = slide.querySelector<HTMLElement>('[data-tap]')!;
			let tapTimer = 0;
			frame.addEventListener('click', (e) => {
				if ((e.target as Element).closest('a, button, .slide-info')) return;
				if (tapTimer) {
					clearTimeout(tapTimer);
					tapTimer = 0;
					setLiked(slide, true);
					const rect = frame.getBoundingClientRect();
					const heart = document.createElement('span');
					heart.className = 'burst';
					heart.innerHTML = likeBtn.querySelector('svg')!.outerHTML;
					heart.style.left = `${e.clientX - rect.left}px`;
					heart.style.top = `${e.clientY - rect.top}px`;
					heart.querySelector('svg')!.setAttribute('width', '100%');
					heart.querySelector('svg')!.setAttribute('height', '100%');
					frame.append(heart);
					heart.addEventListener('animationend', () => heart.remove());
					return;
				}
				tapTimer = window.setTimeout(() => {
					tapTimer = 0;
					const paused = frame.classList.toggle('is-paused');
					const video = frame.querySelector<HTMLVideoElement>('.reel-video');
					if (video) paused ? video.pause() : video.play().catch(() => {});
				}, 260);
			});

			// Progreso del video real
			const video = slide.querySelector<HTMLVideoElement>('.reel-video');
			video?.addEventListener('timeupdate', () => {
				slide.querySelector<HTMLElement>('.reel-progress')?.style.setProperty('--progress', String(video.currentTime / (video.duration || 1)));
			});
		}

		// Enlace compartido: abre el visor directamente en ese short.
		const fromHash = allSlides.find((s) => `#${s.id}` === location.hash);
		if (fromHash) {
			root.scrollIntoView({ behavior: 'instant' });
			open(fromHash.dataset.id, { fromHash: true });
		}
	}
</script>
