---
import Icon from './Icon.astro';
import { getPlans, getExtras, formatUsd } from '../data/content';
import { whatsappLink } from '../data/site';
import { getLang } from '../i18n';

interface Props {
	/** Texto del evento para personalizar el mensaje de WhatsApp. */
	eventLabel?: string;
}

const lang = getLang(Astro.url);
const plans = getPlans(lang);
const extras = getExtras(lang);
const copy = {
	es: {
		event: 'mi evento',
		hint: 'Desliza para ver más planes',
		region: 'Planes y precios',
		featured: 'Más elegido',
		notIncluded: 'No incluye: ',
		meta: (r: number, d: string) => `${r} rondas de cambios · Entrega en ${d}`,
		want: (n: string) => `Quiero el plan ${n}`,
		message: (n: string, e: string) => `¡Hola Invitard! Me interesa el plan ${n} para ${e}.`,
		dot: (n: string) => `Ver plan ${n}`,
		extras: 'Complementos',
		currency: 'Moneda',
		pen: 'Soles',
		usd: 'Dólares',
		notePen: 'Precios en soles para clientes en Perú. Pago del 100 % antes de empezar.',
		noteUsd: 'Precios en dólares (USD) para clientes fuera del Perú. Pago del 100 % antes de empezar.',
	},
	en: {
		event: 'my event',
		hint: 'Swipe to see more plans',
		region: 'Plans and pricing',
		featured: 'Most popular',
		notIncluded: 'Not included: ',
		meta: (r: number, d: string) => `${r} rounds of changes · Delivery in ${d}`,
		want: (n: string) => `I want the ${n} plan`,
		message: (n: string, e: string) => `Hi Invitard! I’m interested in the ${n} plan for ${e}.`,
		dot: (n: string) => `See ${n} plan`,
		extras: 'Add-ons',
		currency: 'Currency',
		pen: 'Soles',
		usd: 'US dollars',
		notePen: 'Prices in Peruvian soles for clients in Peru. 100% payment before we start.',
		noteUsd: 'Prices in US dollars (USD) for clients outside Peru. 100% payment before we start.',
	},
}[lang];

const { eventLabel = copy.event } = Astro.props;
---

<div class="currency-bar">
	<p class="currency-note">
		<span class="in-pen">{copy.notePen}</span>
		<span class="in-usd">{copy.noteUsd}</span>
	</p>
	<div class="currency-toggle" role="group" aria-label={copy.currency}>
		<button type="button" data-set-currency="pen"><span aria-hidden="true">S/</span> {copy.pen}</button>
		<button type="button" data-set-currency="usd"><span aria-hidden="true">US$</span> {copy.usd}</button>
	</div>
</div>

<div class="plans-wrap">
<p class="plans-hint" aria-hidden="true">
	{copy.hint}
	<Icon name="arrow" size="1.1rem" />
</p>

<div class="plans" role="region" aria-label={copy.region}>
	{
		plans.map((p) => (
			<article class:list={['plan', 'reveal', { 'plan--featured': p.featured }]} aria-labelledby={`plan-${p.id}`}>
				{p.featured && <p class="plan-badge">{copy.featured}</p>}
				<h3 id={`plan-${p.id}`}>{p.name}</h3>
				<p class="plan-tagline">{p.tagline}</p>
				<p class="plan-price in-pen">
					<span class="plan-currency">S/</span>
					<span class="plan-amount">{p.price}</span>
					<span class="visually-hidden">soles</span>
				</p>
				<p class="plan-price in-usd">
					<span class="plan-currency">US$</span>
					<span class="plan-amount">{formatUsd(p.priceUsd)}</span>
					<span class="visually-hidden">{lang === 'en' ? 'US dollars' : 'dólares'}</span>
				</p>
				<ul class="plan-list" role="list">
					{p.includes.map((item) => (
						<li>
							<Icon name="check" size="1.15rem" />
							{item}
						</li>
					))}
					{p.notIncluded?.map((item) => (
						<li class="plan-no">
							<Icon name="minus" size="1.15rem" />
							<span>
								<span class="visually-hidden">{copy.notIncluded}</span>
								{item}
							</span>
						</li>
					))}
				</ul>
				<p class="plan-meta">{copy.meta(p.revisions, p.delivery)}</p>
				<a
					class:list={['btn', p.featured ? 'btn--whatsapp' : 'btn--ghost']}
					href={whatsappLink(copy.message(p.name, eventLabel))}
					rel="noopener"
					target="_blank"
				>
					<Icon name="whatsapp" />
					{copy.want(p.name)}
				</a>
			</article>
		))
	}
</div>

<!-- Indicador del carrusel (solo celular) -->
<div class="plans-dots">
	{
		plans.map((p, i) => (
			<button type="button" aria-label={copy.dot(p.name)} aria-current={i === 0 ? 'true' : 'false'}>
				<span></span>
			</button>
		))
	}
</div>
</div>

<!-- «Complementos» oculto por ahora: quita `hidden` para volver a mostrarlo. -->
<div class="extras" hidden>
	<h3>{copy.extras}</h3>
	<ul role="list">
		{
			extras.map((e) => (
				<li>
					<strong>{e.name}</strong>
					<span>{e.text}</span>
					<span class="extra-price">
						<span class="in-pen">S/ {e.price}</span>
						<span class="in-usd">US$ {formatUsd(e.priceUsd)}</span>
					</span>
				</li>
			))
		}
	</ul>
</div>

<script>
	// Selector manual de moneda (se recuerda en el navegador).
	const syncCurrency = () => {
		const current = document.documentElement.dataset.currency;
		document.querySelectorAll<HTMLButtonElement>('[data-set-currency]').forEach((b) => {
			b.setAttribute('aria-pressed', String(b.dataset.setCurrency === current));
		});
	};
	document.querySelectorAll<HTMLButtonElement>('[data-set-currency]').forEach((b) =>
		b.addEventListener('click', () => {
			const value = b.dataset.setCurrency!;
			document.documentElement.dataset.currency = value;
			try {
				localStorage.setItem('invitard:currency', value);
			} catch {
				/* almacenamiento no disponible */
			}
			syncCurrency();
		}),
	);
	syncCurrency();

	// Carrusel de planes en celular: puntos indicadores, oculta la pista al
	// desplazarse y hace el carrusel enfocable con teclado solo si desborda.
	for (const wrap of document.querySelectorAll<HTMLElement>('.plans-wrap')) {
		const list = wrap.querySelector<HTMLElement>('.plans')!;
		const cards = [...list.querySelectorAll<HTMLElement>('.plan')];
		const dots = [...wrap.querySelectorAll<HTMLButtonElement>('.plans-dots button')];
		const reduce = matchMedia('(prefers-reduced-motion: reduce)');

		const setActive = (i: number) => dots.forEach((d, j) => d.setAttribute('aria-current', String(i === j)));

		const io = new IntersectionObserver(
			(entries) => {
				for (const e of entries) if (e.isIntersecting) setActive(cards.indexOf(e.target as HTMLElement));
			},
			{ root: list, threshold: 0.6 },
		);
		cards.forEach((c) => io.observe(c));

		dots.forEach((d, i) =>
			d.addEventListener('click', () => {
				list.scrollTo({ left: cards[i].offsetLeft - cards[0].offsetLeft, behavior: reduce.matches ? 'auto' : 'smooth' });
			}),
		);

		list.addEventListener('scroll', () => wrap.classList.toggle('is-scrolled', list.scrollLeft > 24), { passive: true });

		new ResizeObserver(() => {
			if (list.scrollWidth > list.clientWidth + 1) list.tabIndex = 0;
			else list.removeAttribute('tabindex');
		}).observe(list);
	}
</script>

<style>
	.currency-bar {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: 0.75rem 1.25rem;
		margin-block-end: 2rem;
		text-align: center;
	}

	.currency-note {
		margin: 0;
		font-size: var(--step--1);
		color: var(--ink-soft);
	}

	.currency-toggle {
		display: inline-flex;
		padding: 0.25rem;
		border-radius: 999px;
		background: var(--paper);
		border: 1px solid var(--line);

		& button {
			min-block-size: 2.5rem;
			padding: 0.3rem 0.9rem;
			border: 0;
			border-radius: 999px;
			background: transparent;
			color: var(--ink-soft);
			font: inherit;
			font-size: var(--step--1);
			font-weight: 600;
			cursor: pointer;

			& span {
				font-weight: 800;
			}

			&[aria-pressed='true'] {
				background: var(--ink);
				color: white;
			}
		}
	}

	.plans {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1.5rem;
		align-items: start;

		/* Tablet: los 3 planes lado a lado para compararlos de un vistazo */
		@media (width >= 46rem) {
			grid-template-columns: repeat(3, 1fr);
			gap: 1rem;
		}

		@media (width >= 64rem) {
			gap: 1.5rem;
		}
	}

	/* ── Celular: carrusel horizontal ── */
	.plans-hint,
	.plans-dots {
		display: none;
	}

	@media (width < 46rem) {
		.plans {
			display: flex;
			align-items: stretch;
			gap: 1rem;
			/* Sale del margen del contenedor para que la tarjeta siguiente asome por el borde */
			margin-inline: calc(-1 * var(--gutter));
			padding: 1.25rem var(--gutter) 0.75rem;
			scroll-padding-inline: var(--gutter);
			overflow-x: auto;
			overscroll-behavior-x: contain;
			scroll-snap-type: x mandatory;
			scrollbar-width: none;

			&::-webkit-scrollbar {
				display: none;
			}

			&:focus-visible {
				outline: 3px solid var(--sky-deep);
				outline-offset: -3px;
			}
		}

		.plan {
			flex: 0 0 min(85%, 20rem);
			scroll-snap-align: start;
			/* La animación de aparición depende del scroll vertical: aquí no aplica */
			animation: none;
		}

		.plans-hint {
			display: flex;
			align-items: center;
			justify-content: center;
			gap: 0.4rem;
			margin: 0 0 0.25rem;
			font-size: var(--step--1);
			font-weight: 650;
			color: var(--sky-deep);
			transition: opacity 0.3s;

			.is-scrolled & {
				opacity: 0;
			}

			@media (prefers-reduced-motion: no-preference) {
				& :global(svg) {
					animation: nudge 1.4s ease-in-out infinite;
				}
			}
		}

		.plans-dots {
			display: flex;
			justify-content: center;
			gap: 0.25rem;

			& button {
				display: grid;
				place-items: center;
				min-inline-size: 2rem;
				min-block-size: 2rem;
				padding: 0;
				border: 0;
				background: none;
				cursor: pointer;
			}

			& span {
				inline-size: 0.6rem;
				block-size: 0.6rem;
				border-radius: 999px;
				background: oklch(0.8 0.02 240);
				transition:
					inline-size 0.25s,
					background-color 0.25s;
			}

			& [aria-current='true'] span {
				inline-size: 1.5rem;
				background: var(--ink);
			}

			& button:focus-visible {
				outline: 2px solid var(--sky-deep);
				border-radius: 999px;
			}
		}
	}

	@keyframes nudge {
		50% {
			translate: 0.35rem 0;
		}
	}

	.plan {
		position: relative;
		display: flex;
		flex-direction: column;
		padding: 2rem 1.75rem;
		background: var(--paper);
		border: 2px solid var(--line);
		border-radius: var(--radius-l);

		@media (width < 30rem) {
			padding: 1.75rem 1.25rem;
		}

		@media (46rem <= width < 64rem) {
			padding: 1.75rem 1.1rem;
		}

		& h3 {
			font-size: var(--step-2);
			margin: 0;
		}

		& .btn {
			margin-block-start: 1.25rem;
		}
	}

	.plan--featured {
		border-color: var(--ink);
		background:
			radial-gradient(circle at 100% 0, var(--sky) 0 7rem, transparent 7rem),
			var(--paper);
		box-shadow: var(--shadow-m);

		@media (width >= 64rem) {
			margin-block-start: -1rem;
		}
	}

	.plan-badge {
		position: absolute;
		inset-block-start: -0.9rem;
		inset-inline-start: 1.5rem;
		margin: 0;
		padding: 0.2rem 0.9rem;
		border-radius: 999px;
		background: var(--ink);
		color: white;
		font-size: var(--step--1);
		font-weight: 650;
	}

	.plan-tagline {
		font-family: var(--font-script);
		font-size: var(--step-1);
		color: var(--sky-deep);
		margin-block: 0.15rem 0.5rem;
	}

	.plan-price {
		display: flex;
		align-items: baseline;
		gap: 0.25rem;
		margin-block-end: 1.25rem;
	}

	.plan-currency {
		font-size: var(--step-1);
		font-weight: 600;
	}

	.plan-amount {
		font-size: var(--step-4);
		font-weight: 800;
		line-height: 1;
		letter-spacing: -0.04em;
	}

	.plan-list {
		display: grid;
		gap: 0.55rem;
		padding: 0;
		margin: 0 0 1rem;
		list-style: none;
		font-size: var(--step--1);

		& li {
			display: grid;
			grid-template-columns: auto 1fr;
			gap: 0.55rem;
			align-items: start;
		}

		& svg {
			margin-block-start: 0.2em;
			color: var(--sky-deep);
		}
	}

	.plan-no {
		color: var(--ink-soft);

		& svg {
			color: var(--ink-soft) !important;
		}
	}

	.plan-meta {
		margin: auto 0 0;
		font-size: var(--step--1);
		color: var(--ink-soft);
	}

	.extras {
		margin-block-start: 2.5rem;
		padding: 1.5rem 1.75rem;
		border: 2px dashed var(--sky-strong);
		border-radius: var(--radius-m);

		& h3 {
			margin-block-end: 1rem;
		}

		& ul {
			display: grid;
			gap: 0.9rem;
			padding: 0;
			margin: 0;
			list-style: none;
		}

		& li {
			display: grid;
			grid-template-columns: 1fr auto;
			gap: 0 1rem;

			& span:not(.extra-price) {
				grid-column: 1;
				color: var(--ink-soft);
				font-size: var(--step--1);
			}
		}
	}

	.extra-price {
		grid-column: 2;
		grid-row: 1 / span 2;
		align-self: center;
		font-weight: 750;
		font-size: var(--step-1);
	}
</style>
