---
import Icon from './Icon.astro';
import { getFeatures } from '../data/content';
import { getLang } from '../i18n';

const features = getFeatures(getLang(Astro.url));
---

<ul class="features" role="list">
	{
		features.map((f, i) => (
			<li class="feature reveal" style={`--tilt: ${i % 2 ? 2 : -2}deg`}>
				<span class="feature-icon">
					<Icon name={f.icon} size="1.6rem" />
				</span>
				<h3>{f.title}</h3>
				<p>{f.text}</p>
			</li>
		))
	}
</ul>

<style>
	.features {
		display: grid;
		grid-template-columns: 1fr;
		gap: 0.75rem;

		/* 8 funciones: 2 columnas en tablet y 4 en escritorio, sin huecos */
		@media (width >= 36rem) {
			grid-template-columns: repeat(2, 1fr);
			gap: 1.25rem;
		}

		@media (width >= 64rem) {
			grid-template-columns: repeat(4, 1fr);
		}
		padding: 0;
		margin: 0;
		list-style: none;
	}

	.feature {
		padding: 1.5rem;
		background: var(--paper);
		border: 1px solid var(--line);
		border-radius: var(--radius-m);

		& h3 {
			font-size: var(--step-1);
			margin-block: 1rem 0.35rem;
		}

		& p {
			margin: 0;
			color: var(--ink-soft);
			font-size: var(--step--1);
		}
	}

	/* Celular: ícono a la izquierda y texto a la derecha, más compacto */
	@media (width < 36rem) {
		.feature {
			display: grid;
			grid-template-columns: auto 1fr;
			column-gap: 1rem;
			padding: 1rem 1.1rem;

			& .feature-icon {
				grid-row: 1 / span 2;
				inline-size: 2.75rem;
				block-size: 2.75rem;
			}

			& h3 {
				font-size: var(--step-0);
				margin-block: 0.1rem 0.2rem;
			}
		}
	}

	.feature-icon {
		display: grid;
		place-items: center;
		inline-size: 3.25rem;
		block-size: 3.25rem;
		border-radius: 42% 58% 55% 45% / 50% 45% 55% 50%;
		background: var(--sky);
		rotate: var(--tilt);
	}
</style>
