---
import Icon from './Icon.astro';
import { features } from '../data/content';
---

<ul class="features" role="list">
	{
		features.map((f, i) => (
			<li class="feature reveal" style={`--tilt: ${i % 2 ? 2 : -2}deg`}>
				<span class="feature-icon">
					<Icon name={f.icon} size="1.6rem" />
				</span>
				<h3>{f.title}</h3>
				<p>{f.text}</p>
			</li>
		))
	}
</ul>

<style>
	.features {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
		gap: 1.25rem;
		padding: 0;
		margin: 0;
		list-style: none;
	}

	.feature {
		padding: 1.5rem;
		background: var(--paper);
		border: 1px solid var(--line);
		border-radius: var(--radius-m);

		& h3 {
			font-size: var(--step-1);
			margin-block: 1rem 0.35rem;
		}

		& p {
			margin: 0;
			color: var(--ink-soft);
			font-size: var(--step--1);
		}
	}

	.feature-icon {
		display: grid;
		place-items: center;
		inline-size: 3.25rem;
		block-size: 3.25rem;
		border-radius: 42% 58% 55% 45% / 50% 45% 55% 50%;
		background: var(--sky);
		rotate: var(--tilt);
	}
</style>
