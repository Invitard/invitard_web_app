---
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import type { Category } from '../data/categories';
import { categoryPath, groupOf } from '../data/categories';
import { url } from '../data/site';

interface Props {
	category: Category;
	headingLevel?: 'h3' | 'h4';
}

const { category, headingLevel: H = 'h3' } = Astro.props;
const hue = groupOf(category).hue;
// Primera oración del lead como resumen de la tarjeta.
const summary = category.lead.split(/(?<=[.!?])\s+/)[0];
---

<article class="cat-card reveal" style={`--hue: ${hue}`}>
	<div class="cat-media">
		<Picture
			src={category.image}
			alt={category.imageAlt}
			widths={[360, 560, 760]}
			sizes="(width >= 64rem) 22rem, (width >= 40rem) 45vw, 92vw"
			formats={['avif', 'webp']}
			loading="lazy"
			decoding="async"
		/>
	</div>
	<div class="cat-body">
		<H class="cat-title">
			<a href={url(categoryPath(category))}>Invitaciones de {category.name.toLowerCase()}</a>
		</H>
		<p>{summary}</p>
		<span class="cat-more" aria-hidden="true">Ver diseños <Icon name="arrow" size="1.1rem" /></span>
	</div>
</article>

<style>
	.cat-card {
		position: relative;
		display: flex;
		flex-direction: column;
		background: var(--paper);
		border: 1px solid var(--line);
		border-radius: var(--radius-m);
		overflow: clip;
		box-shadow: var(--shadow-s);
		transition: box-shadow 0.25s;

		&:hover {
			box-shadow: var(--shadow-m);
		}

		&:has(a:focus-visible) {
			outline: 3px solid var(--sky-deep);
			outline-offset: 3px;
		}
	}

	.cat-media {
		overflow: clip;
		background: oklch(0.9 0.05 var(--hue));

		& :global(img) {
			inline-size: 100%;
			block-size: auto;
			aspect-ratio: 4 / 3;
			object-fit: cover;
		}

		@media (prefers-reduced-motion: no-preference) {
			& :global(img) {
				transition: scale 0.5s ease;
			}

			.cat-card:hover & :global(img) {
				scale: 1.05;
			}
		}
	}

	.cat-body {
		display: flex;
		flex-direction: column;
		flex: 1;
		padding: 1.15rem 1.25rem 1.3rem;
		border-block-start: 5px solid oklch(0.82 0.1 var(--hue));

		& p {
			color: var(--ink-soft);
			font-size: var(--step--1);
			flex: 1;
		}
	}

	.cat-title {
		font-size: var(--step-1);
		margin-block-end: 0.4rem;

		& a {
			color: var(--ink);
			text-decoration: none;

			/* Toda la tarjeta es clicable con un solo enlace */
			&::after {
				content: '';
				position: absolute;
				inset: 0;
			}

			&:focus-visible {
				outline: none;
			}
		}
	}

	.cat-more {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		font-weight: 650;
		color: oklch(0.42 0.12 var(--hue));
	}
</style>
