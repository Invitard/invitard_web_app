---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFab from '../components/WhatsAppFab.astro';
import { site, absoluteUrl, url } from '../data/site';
import { plans, formatUsd } from '../data/content';
import { getLang, langMeta, defaultCurrency, routes, type Lang } from '../i18n';

interface Props {
	title: string;
	description: string;
	/** Ruta absoluta de imagen para Open Graph; por defecto la imagen de marca. */
	image?: string;
	imageAlt?: string;
	keywords?: string[];
	jsonLd?: Record<string, unknown>[];
	noindex?: boolean;
	whatsappMessage?: string;
	/** Rutas (sin base path) de esta misma página en cada idioma, para hreflang y el selector de idioma. */
	alternates?: Partial<Record<Lang, string>>;
}

const lang = getLang(Astro.url);
const {
	title,
	description,
	image = absoluteUrl('/og-invitard.jpg'),
	imageAlt = lang === 'en' ? 'Invitard, digital invitations' : 'Invitard, invitaciones digitales',
	keywords = [],
	jsonLd = [],
	noindex = false,
	whatsappMessage,
	alternates = { es: routes.home.es, en: routes.home.en },
} = Astro.props;

const meta = langMeta[lang];
const otherLang: Lang = lang === 'es' ? 'en' : 'es';
const canonical = new URL(Astro.url.pathname, site.url).href;
const fullTitle = title.includes('Invitard') ? title : `${title} | Invitard`;
const altHref = (l: Lang) => (alternates[l] ? absoluteUrl(alternates[l]) : undefined);

// Rango de precios de los planes para Google (soles en español, dólares en inglés).
const penPrices = plans.map((p) => p.price);
const usdPrices = plans.map((p) => p.priceUsd);
const priceRange =
	lang === 'en'
		? `US$ ${formatUsd(Math.min(...usdPrices))} – US$ ${formatUsd(Math.max(...usdPrices))}`
		: `S/ ${Math.min(...penPrices)} – S/ ${Math.max(...penPrices)}`;

const orgId = `${absoluteUrl('/')}#organizacion`;
const baseSchema = [
	{
		'@context': 'https://schema.org',
		'@type': 'ProfessionalService',
		'@id': orgId,
		name: site.name,
		alternateName: site.legalName,
		url: absoluteUrl('/'),
		logo: absoluteUrl('/invitard-logotype.jpeg'),
		image: absoluteUrl('/og-invitard.jpg'),
		description: lang === 'en' ? site.descriptionEn : site.description,
		telephone: `+${site.whatsapp}`,
		email: site.email,
		priceRange,
		currenciesAccepted: 'PEN, USD',
		paymentAccepted: 'Yape, Plin, transferencia bancaria',
		areaServed: site.areaServed.map((name) => ({ '@type': 'Place', name })),
		sameAs: Object.values(site.social),
		knowsLanguage: ['es', 'en'],
	},
	{
		'@context': 'https://schema.org',
		'@type': 'WebSite',
		'@id': `${absoluteUrl(routes.home[lang])}#sitio`,
		url: absoluteUrl(routes.home[lang]),
		name: site.name,
		inLanguage: meta.htmlLang,
		publisher: { '@id': orgId },
	},
];

const schema = [...baseSchema, ...jsonLd];
---


<!doctype html>
<html lang={meta.htmlLang} data-currency={defaultCurrency[lang]}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{fullTitle}</title>
		<meta name="description" content={description} />
		{keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}
		<link rel="canonical" href={canonical} />
		<meta
			name="robots"
			content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'}
		/>
		{altHref('es') && <link rel="alternate" hreflang="es" href={altHref('es')} />}
		{altHref('en') && <link rel="alternate" hreflang="en" href={altHref('en')} />}
		{altHref('es') && <link rel="alternate" hreflang="x-default" href={altHref('es')} />}

		<!--
			Antes de pintar la página:
			1) Idioma: la primera visita se lleva a la versión del idioma del navegador (si es inglés o español).
			   Si la persona eligió un idioma con el selector, se respeta. Los buscadores no se redirigen.
			2) Moneda: soles si la zona horaria es la de Perú; dólares en cualquier otro país.
		-->
		<script is:inline>
			(function () {
				var root = document.documentElement;
				try {
					var current = root.lang.slice(0, 2);
					var saved = localStorage.getItem('invitard:lang');
					var isBot = /bot|crawl|spider|slurp|lighthouse|pagespeed|preview|facebookexternalhit|whatsapp/i.test(navigator.userAgent);
					if (!isBot) {
						var wanted = saved;
						if (!wanted) {
							var list = navigator.languages && navigator.languages.length ? navigator.languages : [navigator.language || ''];
							for (var i = 0; i < list.length; i++) {
								var code = String(list[i]).slice(0, 2).toLowerCase();
								if (code === 'es' || code === 'en') { wanted = code; break; }
							}
						}
						if (wanted && wanted !== current) {
							var alt = document.querySelector('link[rel="alternate"][hreflang="' + wanted + '"]');
							var target = alt && new URL(alt.href).pathname;
							if (target && target !== location.pathname) {
								location.replace(target + location.search + location.hash);
								return;
							}
						}
					}
				} catch (e) {}
				try {
					var currency = localStorage.getItem('invitard:currency');
					if (currency !== 'pen' && currency !== 'usd') {
						var tz = Intl.DateTimeFormat().resolvedOptions().timeZone || '';
						currency = tz === 'America/Lima' ? 'pen' : 'usd';
					}
					root.dataset.currency = currency;
				} catch (e) {}
			})();
		</script>
		<link rel="sitemap" href={url('/sitemap-index.xml')} />

		<meta name="author" content={site.name} />
		<meta name="generator" content={Astro.generator} />

		<!-- Open Graph -->
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={site.name} />
		<meta property="og:locale" content={meta.ogLocale} />
		{altHref(otherLang) && <meta property="og:locale:alternate" content={langMeta[otherLang].ogLocale} />}
		<meta property="og:url" content={canonical} />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={image} />
		<meta property="og:image:alt" content={imageAlt} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />

		<!-- Twitter / X -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={fullTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={image} />
		<meta name="twitter:image:alt" content={imageAlt} />

		<!-- Iconos y PWA -->
		<link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
		<link rel="icon" type="image/png" sizes="192x192" href={url('/icon-192.png')} />
		<link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />
		<link rel="manifest" href={url('/manifest.webmanifest')} />
		<meta name="theme-color" content="#bee3ef" />

		{schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
	</head>
	<body>
		<a class="skip-link" href="#contenido">{lang === 'en' ? 'Skip to content' : 'Saltar al contenido'}</a>
		<Header altHref={alternates[otherLang] ? url(alternates[otherLang]!) : undefined} />
		<main id="contenido">
			<slot />
		</main>
		<Footer />
		<WhatsAppFab message={whatsappMessage} />
	</body>
</html>
