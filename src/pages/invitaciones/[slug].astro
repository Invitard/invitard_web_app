---
import type { GetStaticPaths } from 'astro';
import { Picture, getImage } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CategoryCard from '../../components/CategoryCard.astro';
import Plans from '../../components/Plans.astro';
import Process from '../../components/Process.astro';
import FaqList from '../../components/FaqList.astro';
import CtaBand from '../../components/CtaBand.astro';
import { categories, categoryPath, groupOf, type Category } from '../../data/categories';
import { generalFaqs, plans } from '../../data/content';
import { site, absoluteUrl, url, whatsappLink } from '../../data/site';

export const getStaticPaths = (() =>
	categories.map((category) => ({ params: { slug: category.slug }, props: { category } }))) satisfies GetStaticPaths;

interface Props {
	category: Category;
}

const { category: c } = Astro.props;
const group = groupOf(c);
const path = categoryPath(c);

// Preguntas propias + algunas generales para enriquecer el FAQ.
const faqs = [...c.faqs, ...generalFaqs.slice(1, 4)];

// Relacionadas: primero las del mismo grupo, luego otras.
const related = [
	...categories.filter((x) => x.group === c.group && x.slug !== c.slug),
	...categories.filter((x) => x.group !== c.group),
].slice(0, 3);

const og = await getImage({ src: c.image, width: 1200, height: 630, fit: 'cover', format: 'jpg' });
const ogUrl = new URL(og.src, site.url).href;

const jsonLd = [
	{
		'@context': 'https://schema.org',
		'@type': 'BreadcrumbList',
		itemListElement: [
			{ '@type': 'ListItem', position: 1, name: 'Inicio', item: absoluteUrl('/') },
			{ '@type': 'ListItem', position: 2, name: 'Invitaciones', item: absoluteUrl('/invitaciones/') },
			{ '@type': 'ListItem', position: 3, name: c.h1, item: absoluteUrl(path) },
		],
	},
	{
		'@context': 'https://schema.org',
		'@type': 'Service',
		name: c.h1,
		serviceType: `Invitación digital de ${c.name.toLowerCase()}`,
		category: group.name,
		description: c.metaDescription,
		url: absoluteUrl(path),
		image: ogUrl,
		provider: { '@id': `${absoluteUrl('/')}#organizacion` },
		areaServed: site.areaServed,
		offers: {
			'@type': 'AggregateOffer',
			priceCurrency: site.currency,
			lowPrice: Math.min(...plans.map((p) => p.price)),
			highPrice: Math.max(...plans.map((p) => p.price)),
			offerCount: plans.length,
		},
	},
	{
		'@context': 'https://schema.org',
		'@type': 'FAQPage',
		mainEntity: faqs.map((f) => ({
			'@type': 'Question',
			name: f.q,
			acceptedAnswer: { '@type': 'Answer', text: f.a },
		})),
	},
];
---

<Layout
	title={c.seoTitle}
	description={c.metaDescription}
	image={ogUrl}
	imageAlt={c.imageAlt}
	keywords={c.keywords}
	{jsonLd}
	whatsappMessage={c.whatsappMessage}
>
	<article style={`--hue: ${group.hue}`}>
		<!-- ───────── Cabecera ───────── -->
		<header class="cat-hero">
			<div class="container cat-hero-grid">
				<div>
					<Breadcrumbs
						items={[{ name: 'Inicio', href: url('/') }, { name: 'Invitaciones', href: url('/invitaciones/') }, { name: c.name }]}
					/>
					<a class="group-pill" href={`${url('/invitaciones/')}#grupo-${group.id}`}>{group.name}</a>
					<h1>{c.h1}</h1>
					<p class="cat-lead">{c.lead}</p>
					<div class="cat-actions">
						<a class="btn btn--whatsapp" href={whatsappLink(c.whatsappMessage)} rel="noopener" target="_blank">
							<Icon name="whatsapp" />
							Cotizar mi invitación
						</a>
						<a class="btn btn--ghost" href="#planes">Ver precios</a>
					</div>
				</div>
				<div class="cat-hero-media">
					<Picture
						src={c.image}
						alt={c.imageAlt}
						widths={[400, 640, 900]}
						sizes="(width >= 56rem) 28rem, 92vw"
						formats={['avif', 'webp']}
						loading="eager"
						fetchpriority="high"
					/>
				</div>
			</div>
		</header>

		<!-- ───────── Qué incluye ───────── -->
		<section class="section" aria-labelledby="incluye-title">
			<div class="container">
				<header class="section-head">
					<span class="kicker">Pensada para {c.eventLabel}</span>
					<h2 id="incluye-title">Qué incluye tu invitación digital de {c.name.toLowerCase()}</h2>
				</header>
				<ul class="highlights" role="list">
					{
						c.highlights.map((h) => (
							<li class="reveal">
								<Icon name="sparkle" size="1.4rem" />
								<h3>{h.title}</h3>
								<p>{h.text}</p>
							</li>
						))
					}
				</ul>
			</div>
		</section>

		<!-- ───────── Texto SEO + estilos ───────── -->
		<section class="section section--tint" aria-labelledby="estilos-title">
			<div class="container prose-grid">
				<div class="prose">
					<h2>¿Por qué elegir una invitación web para {c.eventLabel}?</h2>
					{c.body.map((p) => <p>{p}</p>)}
					<p>
						Todas nuestras invitaciones funcionan en Android y iPhone, se comparten por WhatsApp con un enlace y se pueden actualizar
						sin reenviarlas.
					</p>
				</div>
				<aside class="styles" aria-labelledby="estilos-title">
					<h2 id="estilos-title">Estilos que puedes pedir</h2>
					<ul role="list">
						{
							c.styles.map((s) => (
								<li>
									<strong>{s.name}</strong>
									<span>{s.text}</span>
								</li>
							))
						}
					</ul>
					<p class="styles-note">¿Tienes otra idea? La diseñamos desde cero.</p>
				</aside>
			</div>
		</section>

		<!-- ───────── Planes ───────── -->
		<section class="section" id="planes" aria-labelledby="planes-title">
			<div class="container">
				<header class="section-head section-head--center">
					<span class="kicker">Pago único</span>
					<h2 id="planes-title">Precios de invitaciones digitales de {c.name.toLowerCase()}</h2>
				</header>
				<Plans eventLabel={c.eventLabel} />
			</div>
		</section>

		<!-- ───────── Proceso ───────── -->
		<section class="section section--tint" aria-labelledby="proceso-title">
			<div class="container">
				<header class="section-head">
					<h2 id="proceso-title">Así creamos tu invitación</h2>
				</header>
				<Process />
			</div>
		</section>

		<!-- ───────── FAQ ───────── -->
		<section class="section" aria-labelledby="faq-title">
			<div class="container">
				<header class="section-head section-head--center">
					<h2 id="faq-title">Preguntas frecuentes: invitaciones de {c.name.toLowerCase()}</h2>
				</header>
				<FaqList faqs={faqs} headingId="faq-title" />
			</div>
		</section>

		<!-- ───────── Relacionadas ───────── -->
		<section class="section section--tint" aria-labelledby="related-title">
			<div class="container">
				<header class="section-head">
					<h2 id="related-title">También te puede interesar</h2>
				</header>
				<div class="related">
					{related.map((r) => <CategoryCard category={r} />)}
				</div>
				<p class="all-link">
					<a href={url('/invitaciones/')}>Ver todos los tipos de invitaciones <Icon name="arrow" size="1.1rem" /></a>
				</p>
			</div>
		</section>
	</article>

	<CtaBand title={`Hagamos la invitación de ${c.eventLabel}`} message={c.whatsappMessage} />
</Layout>

<style>
	.cat-hero {
		padding-block: clamp(2rem, 1.5rem + 2vw, 3.5rem) clamp(3rem, 2rem + 3vw, 5rem);
		background:
			radial-gradient(ellipse 55% 75% at 90% 40%, oklch(0.9 0.06 var(--hue)) 0 55%, transparent 56%),
			var(--paper);
	}

	.cat-hero-grid {
		display: grid;
		gap: 2.5rem;
		align-items: center;

		@media (width >= 56rem) {
			grid-template-columns: 1.1fr 0.9fr;
		}
	}

	.group-pill {
		display: inline-block;
		margin-block-end: 1rem;
		padding: 0.25rem 0.85rem;
		border-radius: 999px;
		background: oklch(0.9 0.06 var(--hue));
		color: oklch(0.32 0.1 var(--hue));
		font-size: var(--step--1);
		font-weight: 650;
		text-decoration: none;
	}

	.cat-lead {
		font-size: var(--step-1);
		line-height: 1.5;
		color: var(--ink-soft);
		max-inline-size: 38rem;
	}

	.cat-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-block-start: 1.75rem;
	}

	.cat-hero-media {
		position: relative;

		& :global(img) {
			inline-size: 100%;
			aspect-ratio: 4 / 5;
			object-fit: cover;
			border-radius: 45% 55% 40% 60% / 35% 40% 60% 65%;
			box-shadow: var(--shadow-m);
		}

		@media (width < 56rem) {
			& :global(img) {
				aspect-ratio: 4 / 3;
				border-radius: var(--radius-l);
			}
		}
	}

	.highlights {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
		gap: 1.25rem;
		padding: 0;
		margin: 0;
		list-style: none;

		& li {
			padding: 1.5rem;
			border-radius: var(--radius-m);
			border: 1px solid var(--line);
			border-block-start: 5px solid oklch(0.82 0.1 var(--hue));
			background: var(--paper);
		}

		& svg {
			color: oklch(0.5 0.13 var(--hue));
		}

		& h3 {
			margin-block: 0.75rem 0.35rem;
		}

		& p {
			margin: 0;
			color: var(--ink-soft);
			font-size: var(--step--1);
		}
	}

	.prose-grid {
		display: grid;
		gap: 2.5rem;

		@media (width >= 56rem) {
			grid-template-columns: 1.4fr 1fr;
			align-items: start;
		}
	}

	.prose {
		max-inline-size: 65ch;

		& h2 {
			font-size: var(--step-2);
		}
	}

	.styles {
		padding: 1.75rem;
		border-radius: var(--radius-l);
		background: var(--paper);
		border: 1px solid var(--line);

		& h2 {
			font-size: var(--step-1);
		}

		& ul {
			display: grid;
			gap: 1rem;
			margin: 0;
			padding: 0;
			list-style: none;
		}

		& li {
			display: grid;
			gap: 0.1rem;
			padding-inline-start: 1rem;
			border-inline-start: 3px solid oklch(0.82 0.1 var(--hue));

			& span {
				color: var(--ink-soft);
				font-size: var(--step--1);
			}
		}
	}

	.styles-note {
		margin: 1.25rem 0 0;
		font-family: var(--font-script);
		font-size: var(--step-1);
		color: oklch(0.45 0.12 var(--hue));
	}

	.related {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 16.5rem), 1fr));
		gap: 1.5rem;
	}

	.all-link {
		margin-block-start: 2rem;

		& a {
			display: inline-flex;
			align-items: center;
			gap: 0.35rem;
			font-weight: 650;
		}
	}
</style>
