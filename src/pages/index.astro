---
import { Picture } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import CategoryGroups from '../components/CategoryGroups.astro';
import Catalog from '../components/Catalog.astro';
import Features from '../components/Features.astro';
import Plans from '../components/Plans.astro';
import Process from '../components/Process.astro';
import FaqList from '../components/FaqList.astro';
import CtaBand from '../components/CtaBand.astro';
import heroImage from '../assets/stock/boda-pareja.jpg';
import { categories, categoryPath } from '../data/categories';
import { generalFaqs, plans } from '../data/content';
import { site, absoluteUrl, url, whatsappLink } from '../data/site';

const title = 'Invitaciones Digitales Web para Bodas, 15 Años y Cumpleaños | Invitard';
const description =
	'Invitaciones digitales web personalizadas para bodas, quinceaños, cumpleaños, bautizos, baby shower, mascotas, fiestas patronales y eventos. Confirmación por WhatsApp, música y mapa. ¡Cotiza gratis!';

const jsonLd = [
	{
		'@context': 'https://schema.org',
		'@type': 'Service',
		'@id': `${absoluteUrl('/')}#servicio`,
		name: 'Invitaciones digitales web',
		serviceType: 'Diseño de invitaciones digitales',
		provider: { '@id': `${absoluteUrl('/')}#organizacion` },
		areaServed: site.areaServed,
		description,
		offers: plans.map((p) => ({
			'@type': 'Offer',
			name: `Plan ${p.name}`,
			price: p.price,
			priceCurrency: site.currency,
			availability: 'https://schema.org/InStock',
			url: absoluteUrl('/#planes'),
		})),
		hasOfferCatalog: {
			'@type': 'OfferCatalog',
			name: 'Tipos de invitaciones digitales',
			itemListElement: categories.map((c) => ({
				'@type': 'Offer',
				itemOffered: { '@type': 'Service', name: c.h1, url: absoluteUrl(categoryPath(c)) },
			})),
		},
	},
	{
		'@context': 'https://schema.org',
		'@type': 'FAQPage',
		mainEntity: generalFaqs.map((f) => ({
			'@type': 'Question',
			name: f.q,
			acceptedAnswer: { '@type': 'Answer', text: f.a },
		})),
	},
];
---

<Layout {title} {description} {jsonLd} keywords={['invitaciones digitales', 'invitaciones web', 'invitaciones virtuales', 'invitaciones para WhatsApp', 'invitaciones digitales Perú', 'invitaciones digitales Cusco']}>
	<!-- ───────── Hero ───────── -->
	<section class="hero" aria-labelledby="hero-title">
		<div class="container hero-grid">
			<div class="hero-copy">
				<span class="kicker">¡Llegó la invitación!</span>
				<h1 id="hero-title">
					Invitaciones digitales que se abren como <em>un regalo</em>
				</h1>
				<p class="hero-lead">
					Diseñamos invitaciones web para bodas, quinceaños, cumpleaños, bautizos, baby shower, mascotas, fiestas patronales y
					eventos de empresa. Con música, cuenta regresiva, mapa y confirmación por WhatsApp en un solo enlace.
				</p>
				<div class="hero-actions">
					<a class="btn btn--whatsapp" href={whatsappLink('¡Hola Invitard! Quiero cotizar una invitación digital ✨')} rel="noopener" target="_blank">
						<Icon name="whatsapp" />
						Cotizar gratis
					</a>
					<a class="btn btn--ghost" href={url('/invitaciones/')}>
						Ver categorías
						<Icon name="arrow" />
					</a>
				</div>
				<ul class="hero-proof" role="list">
					<li><Icon name="check" size="1.1rem" /> Sin apps</li>
					<li><Icon name="check" size="1.1rem" /> Lista en 48 h</li>
					<li><Icon name="check" size="1.1rem" /> Android y iPhone</li>
				</ul>
			</div>

			<div class="hero-visual">
				<div class="phone">
					<Picture
						src={heroImage}
						alt="Ejemplo de invitación digital de boda abierta en un celular, con la foto de una pareja de novios"
						widths={[320, 480, 640]}
						sizes="(width >= 64rem) 19rem, (width >= 46rem) 25vw, 55vw"
						formats={['avif', 'webp']}
						loading="eager"
						fetchpriority="high"
					/>
					<div class="phone-ui" aria-hidden="true">
						<span class="phone-script">Nos casamos</span>
						<span class="phone-names">Ana &amp; Luis</span>
						<span class="phone-date">Sábado 12 · Diciembre</span>
						<span class="phone-count">
							<b>24</b>días <b>08</b>horas <b>31</b>min
						</span>
						<span class="phone-btn">Confirmar asistencia</span>
					</div>
				</div>
				<span class="float float--rsvp" aria-hidden="true"><Icon name="whatsapp" size="1.1rem" /> Familia Rojas confirmó · 4</span>
				<span class="float float--music" aria-hidden="true"><Icon name="music" size="1.1rem" /> Sonando: su canción</span>
				<span class="drops" aria-hidden="true"><i></i><i></i><i></i></span>
			</div>
		</div>

		<nav class="container quick-cats" aria-label="Tipos de invitación">
			<ul role="list">
				{
					categories.map((c) => (
						<li>
							<a href={url(categoryPath(c))}>{c.name}</a>
						</li>
					))
				}
			</ul>
		</nav>
	</section>

	<!-- ───────── Categorías ───────── -->
	<section class="section" id="categorias" aria-labelledby="categorias-title">
		<div class="container">
			<header class="section-head">
				<span class="kicker">Una invitación para cada ocasión</span>
				<h2 id="categorias-title">Tipos de invitaciones digitales</h2>
				<p>
					Organizamos nuestro trabajo en cuatro familias de celebraciones. Elige la tuya y descubre todo lo que puede incluir tu
					invitación.
				</p>
			</header>
			<CategoryGroups level="h3" />
		</div>
	</section>

	<!-- ───────── Catálogo ───────── -->
	<section class="section section--tint" id="catalogo" aria-labelledby="catalogo-title">
		<div class="container">
			<header class="section-head">
				<span class="kicker">Hecho por Invitard</span>
				<h2 id="catalogo-title">Catálogo de modelos</h2>
				<p>
					Algunos de los diseños que ya hemos creado. Cada uno se adapta a tus nombres, colores y fotos; pide una demo y ábrela en
					tu celular.
				</p>
			</header>
			<Catalog />
		</div>
	</section>

	<!-- ───────── Funcionalidades ───────── -->
	<section class="section" id="funciones" aria-labelledby="funciones-title">
		<div class="container">
			<header class="section-head section-head--center">
				<span class="kicker">Más que una tarjeta bonita</span>
				<h2 id="funciones-title">Todo lo que tu invitación web puede hacer</h2>
				<p>Una invitación digital informa, emociona y además te ayuda a organizar la lista de invitados.</p>
			</header>
			<Features />
		</div>
	</section>

	<!-- ───────── Planes ───────── -->
	<section class="section section--tint" id="planes" aria-labelledby="planes-title">
		<div class="container">
			<header class="section-head section-head--center">
				<span class="kicker">Precios claros</span>
				<h2 id="planes-title">Planes de invitaciones digitales</h2>
				<p>Pago único, sin mensualidades. Todos los planes se diseñan a medida y funcionan en cualquier celular.</p>
			</header>
			<Plans />
		</div>
	</section>

	<!-- ───────── Proceso ───────── -->
	<section class="section" id="proceso" aria-labelledby="proceso-title">
		<div class="container">
			<header class="section-head">
				<span class="kicker">Simple y rápido</span>
				<h2 id="proceso-title">Cómo creamos tu invitación digital</h2>
			</header>
			<Process />
		</div>
	</section>

	<!-- ───────── Preguntas ───────── -->
	<section class="section section--tint" id="preguntas" aria-labelledby="preguntas-title">
		<div class="container">
			<header class="section-head section-head--center">
				<span class="kicker">Resolvemos tus dudas</span>
				<h2 id="preguntas-title">Preguntas frecuentes sobre invitaciones digitales</h2>
			</header>
			<FaqList faqs={generalFaqs} headingId="preguntas-title" />
		</div>
	</section>

	<CtaBand />
</Layout>

<style>
	.hero {
		position: relative;
		overflow: clip;
		padding-block: clamp(2.5rem, 1.5rem + 4vw, 5rem) 2.5rem;
		background:
			radial-gradient(ellipse 60% 70% at 85% 30%, var(--sky) 0 60%, transparent 61%),
			var(--paper);
	}

	.hero-grid {
		display: grid;
		gap: 1.5rem;
		align-items: center;

		/* Tablet en vertical (768px) ya usa dos columnas: texto + celular */
		@media (width >= 46rem) {
			grid-template-columns: 1.2fr 0.8fr;
			gap: 2rem;
		}

		@media (width >= 64rem) {
			grid-template-columns: 1.15fr 0.85fr;
			gap: 3rem;
		}
	}

	.hero-copy h1 {
		& em {
			font-style: normal;
			background: linear-gradient(transparent 62%, var(--sky) 62% 92%, transparent 92%);
			padding-inline: 0.1em;
		}
	}

	.hero-lead {
		font-size: var(--step-1);
		line-height: 1.5;
		color: var(--ink-soft);
		max-inline-size: 38rem;
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-block: 1.75rem 1.5rem;

		/* En celular los botones ocupan todo el ancho: más fáciles de tocar */
		@media (width < 30rem) {
			& .btn {
				flex: 1 1 100%;
			}
		}
	}

	.hero-proof {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.25rem;
		margin: 0;
		padding: 0;
		list-style: none;
		font-size: var(--step--1);
		font-weight: 550;

		& li {
			display: inline-flex;
			align-items: center;
			gap: 0.35rem;
		}

		& svg {
			color: var(--sky-deep);
		}
	}

	/* ── Celular de muestra ── */
	.hero-visual {
		position: relative;
		justify-self: center;
		padding: 2rem 1rem;

		@media (width < 46rem) {
			padding-block: 1.5rem 0.5rem;
		}
	}

	.phone {
		position: relative;
		inline-size: clamp(12rem, 55vw, 17rem);
		aspect-ratio: 9 / 18.5;
		border: 10px solid var(--ink);
		border-radius: 2.6rem;
		overflow: clip;
		background: var(--ink);
		box-shadow:
			0 40px 60px -25px oklch(0.2 0.02 270 / 0.45),
			0 0 0 2px oklch(0.4 0.02 270);
		rotate: 4deg;

		@media (width >= 46rem) {
			inline-size: clamp(13rem, 25vw, 19rem);
			border-width: 8px;
		}

		@media (width >= 64rem) {
			border-width: 10px;
		}

		& :global(img) {
			inline-size: 100%;
			block-size: 100%;
			object-fit: cover;
		}

		@media (prefers-reduced-motion: no-preference) {
			animation: float 7s ease-in-out infinite;
		}
	}

	@keyframes float {
		50% {
			translate: 0 -10px;
			rotate: 2.5deg;
		}
	}

	.phone-ui {
		position: absolute;
		inset: 0;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: end;
		gap: 0.3rem;
		padding: 1.25rem 1rem 1.5rem;
		color: white;
		text-align: center;
		background: linear-gradient(transparent 35%, oklch(0.15 0.02 270 / 0.88));
	}

	.phone-script {
		font-family: var(--font-script);
		font-size: 1.5rem;
		line-height: 1;
	}

	.phone-names {
		font-size: 1.9rem;
		font-weight: 800;
		line-height: 1;
		letter-spacing: -0.02em;
	}

	.phone-date {
		font-size: 0.8rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		opacity: 0.85;
	}

	.phone-count {
		display: flex;
		gap: 0.35rem;
		margin-block: 0.5rem;
		font-size: 0.65rem;
		text-transform: uppercase;
		letter-spacing: 0.05em;

		& b {
			display: block;
			min-inline-size: 2.2rem;
			padding: 0.15rem 0.3rem;
			margin-inline-end: -0.1rem;
			border-radius: 0.5rem;
			background: oklch(1 0 0 / 0.16);
			font-size: 1rem;
		}
	}

	.phone-btn {
		padding: 0.5rem 1rem;
		border-radius: 999px;
		background: var(--sky);
		color: var(--ink);
		font-size: 0.8rem;
		font-weight: 700;
	}

	.float {
		position: absolute;
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.55rem 0.9rem;
		border-radius: 999px;
		background: var(--paper);
		box-shadow: var(--shadow-m);
		font-size: 0.8rem;
		font-weight: 600;
		white-space: nowrap;
	}

	.float--rsvp {
		inset-block-start: 18%;
		inset-inline-start: -2.5rem;
		rotate: -4deg;

		& svg {
			color: oklch(0.55 0.15 150);
		}
	}

	.float--music {
		inset-block-end: 14%;
		inset-inline-end: -1.5rem;
		rotate: 3deg;
	}

	/* Celular y tablet: el celular de muestra es más angosto, se compacta su contenido */
	@media (width < 64rem) {
		.phone-ui {
			padding: 1rem 0.6rem 1.25rem;
		}

		.phone-script {
			font-size: 1.25rem;
		}

		.phone-names {
			font-size: 1.55rem;
		}

		.phone-date {
			font-size: 0.68rem;
			letter-spacing: 0.08em;
		}

		.phone-count {
			gap: 0.2rem;
			font-size: 0.55rem;

			& b {
				min-inline-size: 1.75rem;
				font-size: 0.85rem;
			}
		}

		.phone-btn {
			font-size: 0.72rem;
		}

		.float--music {
			inset-block-end: 2%;
		}
	}

	/* Celular y tablet: etiquetas flotantes más pequeñas y dentro de la pantalla */
	@media (width < 64rem) {
		.float {
			padding: 0.4rem 0.7rem;
			font-size: 0.72rem;
		}

		.float--rsvp {
			inset-inline-start: -1rem;
		}

		.float--music {
			inset-inline-end: -0.5rem;
		}
	}

	.drops {
		position: absolute;
		inset-block-start: -0.25rem;
		inset-inline-start: 1rem;
		display: flex;
		align-items: end;
		gap: 0.3rem;

		& i {
			inline-size: 1.4rem;
			block-size: 2.4rem;
			background: var(--sky-strong);
			border-radius: 50% 50% 50% 50% / 60% 60% 40% 40%;
		}

		& i:nth-child(1) {
			rotate: -28deg;
		}

		& i:nth-child(2) {
			block-size: 3rem;
		}

		& i:nth-child(3) {
			rotate: 28deg;
		}
	}

	/* ── Accesos rápidos a categorías ── */
	.quick-cats {
		margin-block-start: clamp(2.5rem, 2rem + 2vw, 4rem);

		& ul {
			display: flex;
			flex-wrap: wrap;
			justify-content: center;
			gap: 0.5rem;
			margin: 0;
			padding: 0;
			list-style: none;
		}

		& a {
			display: inline-block;
			padding: 0.5rem 1rem;
			border-radius: 999px;
			border: 1px solid var(--line);
			background: var(--paper);
			color: var(--ink);
			font-size: var(--step--1);
			font-weight: 550;
			text-decoration: none;
			transition:
				background-color 0.2s,
				border-color 0.2s;

			&:hover {
				background: var(--sky);
				border-color: var(--sky-strong);
			}
		}

		/* Celular y tablet: una sola fila deslizable en lugar de un bloque de 13 chips */
		@media (width < 48rem) {
			inline-size: 100%;
			margin-block-start: 2rem;

			& ul {
				flex-wrap: nowrap;
				justify-content: start;
				overflow-x: auto;
				overscroll-behavior-x: contain;
				scroll-snap-type: x proximity;
				scroll-padding-inline: var(--gutter);
				padding: 0.25rem var(--gutter);
				scrollbar-width: none;
				mask-image: linear-gradient(to right, #000 calc(100% - 3rem), transparent);

				&::-webkit-scrollbar {
					display: none;
				}
			}

			& li {
				flex: none;
				scroll-snap-align: start;
			}

			& a {
				white-space: nowrap;
			}
		}
	}
</style>
