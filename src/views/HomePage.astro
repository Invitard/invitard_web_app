---
import { Picture } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import CategoryGroups from '../components/CategoryGroups.astro';
import Features from '../components/Features.astro';
import Plans from '../components/Plans.astro';
import Process from '../components/Process.astro';
import FaqList from '../components/FaqList.astro';
import CtaBand from '../components/CtaBand.astro';
import Shorts from '../components/Shorts.astro';
import { featuredShorts } from '../data/shorts';
import heroImage from '../assets/stock/boda-pareja.jpg';
import { getCategories, categoryPath } from '../data/categories';
import { getGeneralFaqs, getPlans } from '../data/content';
import { site, absoluteUrl, url, whatsappLink } from '../data/site';
import { getLang, routes } from '../i18n';

// «Catálogo de modelos» (components/Catalog.astro) está oculto: los shorts son ahora el catálogo.

const lang = getLang(Astro.url);
const categories = getCategories(lang);
const plans = getPlans(lang);
const generalFaqs = getGeneralFaqs(lang);
const home = routes.home[lang];

const copy = {
	es: {
		title: 'Invitaciones Digitales Web para Bodas, 15 Años y Cumpleaños | Invitard',
		description:
			'Invitaciones digitales web personalizadas para bodas, quinceaños, cumpleaños, bautizos, baby shower, mascotas y eventos. Para clientes de todo el mundo. Confirmación por WhatsApp, música y mapa. ¡Cotiza gratis!',
		keywords: [
			'invitaciones digitales',
			'invitaciones web',
			'invitaciones virtuales',
			'invitaciones para WhatsApp',
			'invitaciones digitales online',
			'invitaciones digitales personalizadas',
		],
		serviceName: 'Invitaciones digitales web',
		serviceType: 'Diseño de invitaciones digitales',
		catalogName: 'Tipos de invitaciones digitales',
		kicker: '¡Llegó la invitación!',
		h1: 'Invitaciones digitales que se abren como <em>un regalo</em>',
		lead: 'Diseñamos invitaciones web para bodas, quinceaños, cumpleaños, bautizos, baby shower, mascotas, fiestas patronales y eventos de empresa. Con música, cuenta regresiva, mapa y confirmación por WhatsApp en un solo enlace.',
		quoteMessage: '¡Hola Invitard! Quiero cotizar una invitación digital ✨',
		quote: 'Cotizar gratis',
		seeShorts: 'Ver shorts',
		proof: ['Clientes en todo el mundo', 'Lista en 48 h', 'Android y iPhone'],
		phoneAlt: 'Ejemplo de invitación digital de boda abierta en un celular, con la foto de una pareja de novios',
		phone: { script: 'Nos casamos', date: 'Sábado 12 · Diciembre', units: ['días', 'horas', 'min'], btn: 'Confirmar asistencia' },
		floatRsvp: 'Familia Rojas confirmó · 4',
		floatMusic: 'Sonando: su canción',
		quickNav: 'Tipos de invitación',
		shortsTitle: 'Nuestras invitaciones en video',
		shortsLead: 'Así se ven y se sienten en el celular de tus invitados. Busca tu tipo de evento, toca un short y desliza para ver más.',
		catKicker: 'Una invitación para cada ocasión',
		catTitle: 'Tipos de invitaciones digitales',
		catLead:
			'Organizamos nuestro trabajo en cuatro familias de celebraciones. Elige la tuya y descubre todo lo que puede incluir tu invitación.',
		featKicker: 'Más que una tarjeta bonita',
		featTitle: 'Todo lo que tu invitación web puede hacer',
		featLead: 'Una invitación digital informa, emociona y además te ayuda a organizar la lista de invitados.',
		planKicker: 'Precios claros',
		planTitle: 'Planes de invitaciones digitales',
		planLead: 'Pago único, sin mensualidades. Todos los planes se diseñan a medida y funcionan en cualquier celular.',
		procKicker: 'Simple y rápido',
		procTitle: 'Cómo creamos tu invitación digital',
		faqKicker: 'Resolvemos tus dudas',
		faqTitle: 'Preguntas frecuentes sobre invitaciones digitales',
	},
	en: {
		title: 'Digital Invitations for Weddings, Quinceañeras & Birthdays | Invitard',
		description:
			'Custom digital web invitations for weddings, quinceañeras, birthdays, baptisms, baby showers, pet parties and events. For clients worldwide, in any language. WhatsApp RSVP, music and maps. Free quote!',
		keywords: [
			'digital invitations',
			'online invitations',
			'web invitations',
			'WhatsApp invitations',
			'digital wedding invitations',
			'quinceañera invitations',
		],
		serviceName: 'Digital web invitations',
		serviceType: 'Digital invitation design',
		catalogName: 'Types of digital invitations',
		kicker: 'You’re invited!',
		h1: 'Digital invitations that open like <em>a gift</em>',
		lead: 'We design web invitations for weddings, quinceañeras, birthdays, baptisms, baby showers, pet parties, traditional festivals and corporate events. With music, countdown, map and WhatsApp RSVP in a single link.',
		quoteMessage: 'Hi Invitard! I’d like a quote for a digital invitation ✨',
		quote: 'Get a free quote',
		seeShorts: 'Watch shorts',
		proof: ['Clients worldwide', 'Ready in 48 h', 'Android & iPhone'],
		phoneAlt: 'Example of a digital wedding invitation open on a phone, with a photo of a bride and groom',
		phone: { script: 'We’re getting married', date: 'Saturday · December 12', units: ['days', 'hours', 'min'], btn: 'RSVP now' },
		floatRsvp: 'Rojas family confirmed · 4',
		floatMusic: 'Now playing: their song',
		quickNav: 'Invitation types',
		shortsTitle: 'Our invitations on video',
		shortsLead: 'This is how they look and feel on your guests’ phones. Search your event type, tap a short and swipe for more.',
		catKicker: 'An invitation for every occasion',
		catTitle: 'Types of digital invitations',
		catLead: 'Our work is organized into four families of celebrations. Choose yours and discover everything your invitation can include.',
		featKicker: 'More than a pretty card',
		featTitle: 'Everything your web invitation can do',
		featLead: 'A digital invitation informs, excites and also helps you manage your guest list.',
		planKicker: 'Clear pricing',
		planTitle: 'Digital invitation plans',
		planLead: 'One-time payment, no subscriptions. Every plan is custom designed and works on any phone.',
		procKicker: 'Simple and fast',
		procTitle: 'How we create your digital invitation',
		faqKicker: 'Your questions, answered',
		faqTitle: 'Frequently asked questions about digital invitations',
	},
}[lang];

const usd = lang === 'en';
const jsonLd = [
	{
		'@context': 'https://schema.org',
		'@type': 'Service',
		'@id': `${absoluteUrl(home)}#servicio`,
		name: copy.serviceName,
		serviceType: copy.serviceType,
		provider: { '@id': `${absoluteUrl('/')}#organizacion` },
		areaServed: site.areaServed,
		description: copy.description,
		offers: plans.map((p) => ({
			'@type': 'Offer',
			name: `Plan ${p.name}`,
			price: usd ? p.priceUsd : p.price,
			priceCurrency: usd ? 'USD' : site.currency,
			availability: 'https://schema.org/InStock',
			url: absoluteUrl(`${home}#planes`),
		})),
		hasOfferCatalog: {
			'@type': 'OfferCatalog',
			name: copy.catalogName,
			itemListElement: categories.map((c) => ({
				'@type': 'Offer',
				itemOffered: { '@type': 'Service', name: c.h1, url: absoluteUrl(categoryPath(c, lang)) },
			})),
		},
	},
	{
		'@context': 'https://schema.org',
		'@type': 'FAQPage',
		mainEntity: generalFaqs.map((f) => ({
			'@type': 'Question',
			name: f.q,
			acceptedAnswer: { '@type': 'Answer', text: f.a },
		})),
	},
];
---

<Layout title={copy.title} description={copy.description} {jsonLd} keywords={copy.keywords} alternates={routes.home}>
	<!-- ───────── Hero ───────── -->
	<section class="hero" aria-labelledby="hero-title">
		<div class="container hero-grid">
			<div class="hero-copy">
				<span class="kicker">{copy.kicker}</span>
				<h1 id="hero-title" set:html={copy.h1} />
				<p class="hero-lead">{copy.lead}</p>
				<div class="hero-actions">
					<a class="btn btn--whatsapp" href={whatsappLink(copy.quoteMessage)} rel="noopener" target="_blank">
						<Icon name="whatsapp" />
						{copy.quote}
					</a>
					<a class="btn btn--ghost" href="#shorts">
						{copy.seeShorts}
						<Icon name="arrow" />
					</a>
				</div>
				<ul class="hero-proof" role="list">
					{copy.proof.map((p) => (
						<li>
							<Icon name="check" size="1.1rem" /> {p}
						</li>
					))}
				</ul>
			</div>

			<div class="hero-visual">
				<div class="phone">
					<Picture
						src={heroImage}
						alt={copy.phoneAlt}
						widths={[320, 480, 640]}
						sizes="(width >= 64rem) 19rem, (width >= 46rem) 25vw, 55vw"
						formats={['avif', 'webp']}
						loading="eager"
						fetchpriority="high"
					/>
					<div class="phone-ui" aria-hidden="true">
						<span class="phone-script">{copy.phone.script}</span>
						<span class="phone-names">Ana &amp; Luis</span>
						<span class="phone-date">{copy.phone.date}</span>
						<span class="phone-count">
							<b>24</b>{copy.phone.units[0]} <b>08</b>{copy.phone.units[1]} <b>31</b>{copy.phone.units[2]}
						</span>
						<span class="phone-btn">{copy.phone.btn}</span>
					</div>
				</div>
				<span class="float float--rsvp" aria-hidden="true"><Icon name="whatsapp" size="1.1rem" /> {copy.floatRsvp}</span>
				<span class="float float--music" aria-hidden="true"><Icon name="music" size="1.1rem" /> {copy.floatMusic}</span>
				<span class="drops" aria-hidden="true"><i></i><i></i><i></i></span>
			</div>
		</div>

		<nav class="container quick-cats" aria-label={copy.quickNav}>
			<ul role="list">
				{
					categories.map((c) => (
						<li>
							<a href={url(categoryPath(c, lang))}>{c.name}</a>
						</li>
					))
				}
			</ul>
		</nav>
	</section>

	<!-- ───────── Shorts (catálogo en video) ───────── -->
	<Shorts shorts={featuredShorts(lang)} title={copy.shortsTitle} lead={copy.shortsLead} searchable />

	<!-- ───────── Categorías ───────── -->
	<section class="section" id="categorias" aria-labelledby="categorias-title">
		<div class="container">
			<header class="section-head">
				<span class="kicker">{copy.catKicker}</span>
				<h2 id="categorias-title">{copy.catTitle}</h2>
				<p>{copy.catLead}</p>
			</header>
			<CategoryGroups level="h3" />
		</div>
	</section>

	<!-- ───────── Funcionalidades ───────── -->
	<section class="section" id="funciones" aria-labelledby="funciones-title">
		<div class="container">
			<header class="section-head section-head--center">
				<span class="kicker">{copy.featKicker}</span>
				<h2 id="funciones-title">{copy.featTitle}</h2>
				<p>{copy.featLead}</p>
			</header>
			<Features />
		</div>
	</section>

	<!-- ───────── Planes ───────── -->
	<section class="section section--tint" id="planes" aria-labelledby="planes-title">
		<div class="container">
			<header class="section-head section-head--center">
				<span class="kicker">{copy.planKicker}</span>
				<h2 id="planes-title">{copy.planTitle}</h2>
				<p>{copy.planLead}</p>
			</header>
			<Plans />
		</div>
	</section>

	<!-- ───────── Proceso ───────── -->
	<section class="section" id="proceso" aria-labelledby="proceso-title">
		<div class="container">
			<header class="section-head">
				<span class="kicker">{copy.procKicker}</span>
				<h2 id="proceso-title">{copy.procTitle}</h2>
			</header>
			<Process />
		</div>
	</section>

	<!-- ───────── Preguntas ───────── -->
	<section class="section section--tint" id="preguntas" aria-labelledby="preguntas-title">
		<div class="container">
			<header class="section-head section-head--center">
				<span class="kicker">{copy.faqKicker}</span>
				<h2 id="preguntas-title">{copy.faqTitle}</h2>
			</header>
			<FaqList faqs={generalFaqs} headingId="preguntas-title" />
		</div>
	</section>

	<CtaBand />
</Layout>

<style>
	.hero {
		position: relative;
		overflow: clip;
		padding-block: clamp(2.5rem, 1.5rem + 4vw, 5rem) 2.5rem;
		background:
			radial-gradient(ellipse 60% 70% at 85% 30%, var(--sky) 0 60%, transparent 61%),
			var(--paper);
	}

	.hero-grid {
		display: grid;
		gap: 1.5rem;
		align-items: center;

		/* Tablet en vertical (768px) ya usa dos columnas: texto + celular */
		@media (width >= 46rem) {
			grid-template-columns: 1.2fr 0.8fr;
			gap: 2rem;
		}

		@media (width >= 64rem) {
			grid-template-columns: 1.15fr 0.85fr;
			gap: 3rem;
		}
	}

	.hero-copy h1 {
		& em {
			font-style: normal;
			background: linear-gradient(transparent 62%, var(--sky) 62% 92%, transparent 92%);
			padding-inline: 0.1em;
		}
	}

	.hero-lead {
		font-size: var(--step-1);
		line-height: 1.5;
		color: var(--ink-soft);
		max-inline-size: 38rem;
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-block: 1.75rem 1.5rem;

		/* En celular los botones ocupan todo el ancho: más fáciles de tocar */
		@media (width < 30rem) {
			& .btn {
				flex: 1 1 100%;
			}
		}
	}

	.hero-proof {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.25rem;
		margin: 0;
		padding: 0;
		list-style: none;
		font-size: var(--step--1);
		font-weight: 550;

		& li {
			display: inline-flex;
			align-items: center;
			gap: 0.35rem;
		}

		& svg {
			color: var(--sky-deep);
		}
	}

	/* ── Celular de muestra ── */
	.hero-visual {
		position: relative;
		justify-self: center;
		padding: 2rem 1rem;

		@media (width < 46rem) {
			padding-block: 1.5rem 0.5rem;
		}
	}

	.phone {
		position: relative;
		inline-size: clamp(12rem, 55vw, 17rem);
		aspect-ratio: 9 / 18.5;
		border: 10px solid var(--ink);
		border-radius: 2.6rem;
		overflow: clip;
		background: var(--ink);
		box-shadow:
			0 40px 60px -25px oklch(0.2 0.02 270 / 0.45),
			0 0 0 2px oklch(0.4 0.02 270);
		rotate: 4deg;

		@media (width >= 46rem) {
			inline-size: clamp(13rem, 25vw, 19rem);
			border-width: 8px;
		}

		@media (width >= 64rem) {
			border-width: 10px;
		}

		& :global(img) {
			inline-size: 100%;
			block-size: 100%;
			object-fit: cover;
		}

		@media (prefers-reduced-motion: no-preference) {
			animation: float 7s ease-in-out infinite;
		}
	}

	@keyframes float {
		50% {
			translate: 0 -10px;
			rotate: 2.5deg;
		}
	}

	.phone-ui {
		position: absolute;
		inset: 0;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: end;
		gap: 0.3rem;
		padding: 1.25rem 1rem 1.5rem;
		color: white;
		text-align: center;
		background: linear-gradient(transparent 35%, oklch(0.15 0.02 270 / 0.88));
	}

	.phone-script {
		font-family: var(--font-script);
		font-size: 1.5rem;
		line-height: 1;
	}

	.phone-names {
		font-size: 1.9rem;
		font-weight: 800;
		line-height: 1;
		letter-spacing: -0.02em;
	}

	.phone-date {
		font-size: 0.8rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		opacity: 0.85;
	}

	.phone-count {
		display: flex;
		gap: 0.35rem;
		margin-block: 0.5rem;
		font-size: 0.65rem;
		text-transform: uppercase;
		letter-spacing: 0.05em;

		& b {
			display: block;
			min-inline-size: 2.2rem;
			padding: 0.15rem 0.3rem;
			margin-inline-end: -0.1rem;
			border-radius: 0.5rem;
			background: oklch(1 0 0 / 0.16);
			font-size: 1rem;
		}
	}

	.phone-btn {
		padding: 0.5rem 1rem;
		border-radius: 999px;
		background: var(--sky);
		color: var(--ink);
		font-size: 0.8rem;
		font-weight: 700;
	}

	.float {
		position: absolute;
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.55rem 0.9rem;
		border-radius: 999px;
		background: var(--paper);
		box-shadow: var(--shadow-m);
		font-size: 0.8rem;
		font-weight: 600;
		white-space: nowrap;
	}

	.float--rsvp {
		inset-block-start: 18%;
		inset-inline-start: -2.5rem;
		rotate: -4deg;

		& svg {
			color: oklch(0.55 0.15 150);
		}
	}

	.float--music {
		inset-block-end: 14%;
		inset-inline-end: -1.5rem;
		rotate: 3deg;
	}

	/* Celular y tablet: el celular de muestra es más angosto, se compacta su contenido */
	@media (width < 64rem) {
		.phone-ui {
			padding: 1rem 0.6rem 1.25rem;
		}

		.phone-script {
			font-size: 1.25rem;
		}

		.phone-names {
			font-size: 1.55rem;
		}

		.phone-date {
			font-size: 0.68rem;
			letter-spacing: 0.08em;
		}

		.phone-count {
			gap: 0.2rem;
			font-size: 0.55rem;

			& b {
				min-inline-size: 1.75rem;
				font-size: 0.85rem;
			}
		}

		.phone-btn {
			font-size: 0.72rem;
		}

		.float--music {
			inset-block-end: 2%;
		}
	}

	/* Celular y tablet: etiquetas flotantes más pequeñas y dentro de la pantalla */
	@media (width < 64rem) {
		.float {
			padding: 0.4rem 0.7rem;
			font-size: 0.72rem;
		}

		.float--rsvp {
			inset-inline-start: -1rem;
		}

		.float--music {
			inset-inline-end: -0.5rem;
		}
	}

	.drops {
		position: absolute;
		inset-block-start: -0.25rem;
		inset-inline-start: 1rem;
		display: flex;
		align-items: end;
		gap: 0.3rem;

		& i {
			inline-size: 1.4rem;
			block-size: 2.4rem;
			background: var(--sky-strong);
			border-radius: 50% 50% 50% 50% / 60% 60% 40% 40%;
		}

		& i:nth-child(1) {
			rotate: -28deg;
		}

		& i:nth-child(2) {
			block-size: 3rem;
		}

		& i:nth-child(3) {
			rotate: 28deg;
		}
	}

	/* ── Accesos rápidos a categorías ── */
	.quick-cats {
		margin-block-start: clamp(2.5rem, 2rem + 2vw, 4rem);

		& ul {
			display: flex;
			flex-wrap: wrap;
			justify-content: center;
			gap: 0.5rem;
			margin: 0;
			padding: 0;
			list-style: none;
		}

		& a {
			display: inline-block;
			padding: 0.5rem 1rem;
			border-radius: 999px;
			border: 1px solid var(--line);
			background: var(--paper);
			color: var(--ink);
			font-size: var(--step--1);
			font-weight: 550;
			text-decoration: none;
			transition:
				background-color 0.2s,
				border-color 0.2s;

			&:hover {
				background: var(--sky);
				border-color: var(--sky-strong);
			}
		}

		/* Celular y tablet: una sola fila deslizable en lugar de un bloque de 13 chips */
		@media (width < 48rem) {
			inline-size: 100%;
			margin-block-start: 2rem;

			& ul {
				flex-wrap: nowrap;
				justify-content: start;
				overflow-x: auto;
				overscroll-behavior-x: contain;
				scroll-snap-type: x proximity;
				scroll-padding-inline: var(--gutter);
				padding: 0.25rem var(--gutter);
				scrollbar-width: none;
				mask-image: linear-gradient(to right, #000 calc(100% - 3rem), transparent);

				&::-webkit-scrollbar {
					display: none;
				}
			}

			& li {
				flex: none;
				scroll-snap-align: start;
			}

			& a {
				white-space: nowrap;
			}
		}
	}
</style>
